<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - GRANA</title>
    <link rel="icon" type="image/svg+xml" href="~/images/grana-icon.svg" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/images/grana-icon-32.png" asp-append-version="true" />
    <link rel="shortcut icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/images/grana-icon-180.png" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Portal.ControleFinanceiro.styles.css" asp-append-version="true" />
</head>
<body class="home-app-body">
    <div class="home-app-shell">
        <aside class="home-sidebar" aria-label="Navegação principal">
            <a class="home-brand" asp-page="/Index" aria-label="Ir para a página inicial">
                <img src="~/images/grana-icon.svg" asp-append-version="true" alt="" />
                <strong>GRANA</strong>
            </a>

            <nav class="home-sidebar-nav">
                <a class="active" asp-page="/Index"><i class="bi bi-grid-1x2" aria-hidden="true"></i><span>Visão geral</span></a>
                <a asp-page="/Controle/Resumo"><i class="bi bi-bar-chart-line" aria-hidden="true"></i><span>Resumo</span></a>
                <a asp-page="/Controle/RegistrarCompra"><i class="bi bi-receipt" aria-hidden="true"></i><span>Compras</span></a>
                <a asp-page="/Controle/Fixos"><i class="bi bi-calendar-check" aria-hidden="true"></i><span>Gastos fixos</span></a>
                <a asp-page="/Controle/RegistrarEntrada"><i class="bi bi-wallet2" aria-hidden="true"></i><span>Entradas</span></a>
                <a asp-page="/Controle/CalculadoraHorasUteis"><i class="bi bi-clock-history" aria-hidden="true"></i><span>Horas úteis</span></a>
            </nav>

            <div class="home-sidebar-footer">
                <a asp-page="/Shared/Logout"><i class="bi bi-box-arrow-left" aria-hidden="true"></i><span>Sair</span></a>
                <span class="app-version" aria-label="Versão do aplicativo">@ApplicationVersion.Current</span>
            </div>
        </aside>

        <div class="home-mobile-header">
            <a class="home-brand" asp-page="/Index"><img src="~/images/grana-icon.svg" asp-append-version="true" alt="" /><strong>GRANA</strong></a>
            <a class="home-mobile-logout" asp-page="/Shared/Logout" aria-label="Sair"><i class="bi bi-box-arrow-right" aria-hidden="true"></i></a>
        </div>

        <div class="home-shell-content">
            @RenderBody()
        </div>

        <nav class="home-bottom-nav" aria-label="Navegação principal">
            <a class="active" asp-page="/Index"><i class="bi bi-grid-1x2" aria-hidden="true"></i><span>Início</span></a>
            <a asp-page="/Controle/Resumo"><i class="bi bi-bar-chart-line" aria-hidden="true"></i><span>Resumo</span></a>
            <a asp-page="/Controle/RegistrarCompra"><i class="bi bi-plus-circle" aria-hidden="true"></i><span>Compra</span></a>
            <a asp-page="/Controle/Fixos"><i class="bi bi-calendar-check" aria-hidden="true"></i><span>Fixos</span></a>
            <a asp-page="/Controle/CalculadoraHorasUteis"><i class="bi bi-clock-history" aria-hidden="true"></i><span>Horas</span></a>
        </nav>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
