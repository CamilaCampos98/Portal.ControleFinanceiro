@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#183a37" />
    <title>@ViewData["Title"] - GRANA</title>
    <link rel="icon" type="image/svg+xml" href="~/images/grana-icon.svg" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/images/grana-icon-32.png" asp-append-version="true" />
    <link rel="shortcut icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/images/grana-icon-180.png" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        :root { --login-ink:#1f2a2e; --login-muted:#66777d; --login-line:#d9e4df; --login-brand:#214e4a; --login-brand-strong:#183a37; --login-accent:#2f9c85; --login-accent-soft:#dff2ec; }
        * { box-sizing: border-box; }
        body { min-height:100vh; margin:0; background:#edf3f0; color:var(--login-ink); font-family:"Segoe UI",Tahoma,Geneva,Verdana,sans-serif; }
        .login-shell { min-height:100vh; display:grid; grid-template-columns:minmax(360px,.95fr) minmax(480px,1.05fr); }
        .login-showcase { position:relative; isolation:isolate; overflow:hidden; display:flex; flex-direction:column; justify-content:space-between; min-height:100vh; padding:clamp(2rem,5vw,4.5rem); background:linear-gradient(145deg,#173b38 0%,#214e4a 58%,#286c5e 100%); color:#fff; }
        .login-showcase::before,.login-showcase::after { content:""; position:absolute; z-index:-1; border-radius:50%; border:1px solid rgba(255,255,255,.1); }
        .login-showcase::before { width:430px; height:430px; right:-180px; top:-140px; }
        .login-showcase::after { width:520px; height:520px; left:-280px; bottom:-310px; }
        .login-brand { display:flex; align-items:center; gap:.8rem; color:#fff; }
        .login-brand img { width:48px; height:48px; border-radius:13px; box-shadow:0 10px 24px rgba(0,0,0,.22); }
        .login-brand strong { display:block; font-size:1.15rem; letter-spacing:.12em; }
        .login-brand small { display:block; color:#b9d9d1; font-size:.72rem; font-weight:700; }
        .login-showcase-copy { max-width:540px; }
        .login-showcase-copy > span { color:#8fe0cc; font-size:.78rem; font-weight:800; letter-spacing:.1em; text-transform:uppercase; }
        .login-showcase-copy h1 { max-width:500px; margin:.65rem 0 1rem; font-size:clamp(2.4rem,5vw,4.6rem); font-weight:800; letter-spacing:-.05em; line-height:.98; }
        .login-showcase-copy p { max-width:480px; margin:0; color:#c7ddd8; font-size:clamp(1rem,1.5vw,1.15rem); line-height:1.6; }
        .login-showcase-features { display:flex; flex-wrap:wrap; gap:.65rem; margin-top:1.75rem; }
        .login-showcase-features span { display:inline-flex; align-items:center; gap:.4rem; padding:.45rem .7rem; border:1px solid rgba(255,255,255,.14); border-radius:999px; background:rgba(255,255,255,.07); color:#e1f0ec; font-size:.78rem; font-weight:700; }
        .login-showcase-footer { color:#9fc2ba; font-size:.76rem; font-weight:700; }
        .login-access { display:grid; place-items:center; min-height:100vh; padding:clamp(1.25rem,5vw,4rem); background:radial-gradient(circle at 90% 10%,rgba(47,156,133,.12),transparent 32%),#f5f8f6; }
        .login-container { width:min(430px,100%); }
        .login-mobile-brand { display:none; align-items:center; gap:.65rem; margin-bottom:1.5rem; color:var(--login-brand-strong); }
        .login-mobile-brand img { width:42px; height:42px; border-radius:11px; }
        .login-mobile-brand strong { letter-spacing:.1em; }
        .login-card { padding:clamp(1.5rem,4vw,2.35rem); border:1px solid var(--login-line); border-radius:18px; background:#fff; box-shadow:0 24px 65px rgba(29,61,57,.13); }
        .login-heading { margin-bottom:1.65rem; }
        .login-eyebrow { display:block; margin-bottom:.35rem; color:var(--login-accent); font-size:.75rem; font-weight:800; letter-spacing:.08em; text-transform:uppercase; }
        .login-heading h2 { margin:0; color:var(--login-ink); font-size:clamp(1.7rem,4vw,2.1rem); font-weight:800; }
        .login-heading p { margin:.45rem 0 0; color:var(--login-muted); line-height:1.5; }
        .login-form { display:grid; gap:1rem; }
        .login-field label { margin-bottom:.4rem; color:var(--login-ink); font-size:.82rem; font-weight:800; }
        .login-input { position:relative; }
        .login-input i { position:absolute; top:50%; left:.9rem; transform:translateY(-50%); color:var(--login-muted); }
        .login-input .form-control { min-height:50px; padding-left:2.65rem; border:1px solid var(--login-line); border-radius:10px; background:#f9fbfa; color:var(--login-ink); }
        .login-input .form-control::placeholder { color:#98a5a1; }
        .login-input .form-control:focus { border-color:var(--login-accent); background:#fff; box-shadow:0 0 0 .22rem rgba(47,156,133,.14); }
        .btn-login { min-height:50px; margin-top:.35rem; border:0; border-radius:10px; background:var(--login-brand); color:#fff; font-weight:800; box-shadow:0 10px 24px rgba(33,78,74,.18); }
        .btn-login:hover,.btn-login:focus { background:var(--login-brand-strong); color:#fff; }
        .login-alert { display:flex; align-items:flex-start; gap:.55rem; margin-bottom:1rem; border:1px solid #efc3bd; border-radius:10px; background:#fff4f2; color:#9b352d; font-size:.88rem; }
        .login-validation { margin:0; font-size:.78rem; }
        .login-security { display:flex; align-items:center; justify-content:center; gap:.4rem; margin-top:1.1rem; color:var(--login-muted); font-size:.75rem; font-weight:700; }
        .app-version { display:block; margin-top:1.15rem; color:#82918c; font-size:.7rem; font-weight:700; letter-spacing:.04em; text-align:center; }
        @@media (max-width:860px) {
            .login-shell { grid-template-columns:1fr; }
            .login-showcase { display:none; }
            .login-access { padding:1rem; }
            .login-mobile-brand { display:flex; }
            .login-card { border-radius:15px; }
        }
    </style>
</head>
<body>
    <div class="login-shell">
        <aside class="login-showcase">
            <div class="login-brand"><img src="~/images/grana-icon.svg" asp-append-version="true" alt="" /><div><strong>GRANA</strong><small>FINANÇAS PESSOAIS</small></div></div>
            <div class="login-showcase-copy"><span>Seu dinheiro, mais claro</span><h1>Controle hoje. Planeje amanhã.</h1><p>Acompanhe compras, cartões, gastos fixos e entradas em um só lugar.</p><div class="login-showcase-features"><span><i class="bi bi-pie-chart"></i> Resumo mensal</span><span><i class="bi bi-credit-card"></i> Cartões</span><span><i class="bi bi-calendar-check"></i> Gastos fixos</span></div></div>
            <div class="login-showcase-footer">Controle financeiro pessoal, simples e direto.</div>
        </aside>
        <main class="login-access">
            <div class="login-container">
                <div class="login-mobile-brand"><img src="~/images/grana-icon.svg" asp-append-version="true" alt="" /><strong>GRANA</strong></div>
                <section class="login-card">@RenderBody()</section>
                <span class="app-version" aria-label="Versão do aplicativo">Versão @ApplicationVersion.Current</span>
            </div>
        </main>
    </div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
