@page
@model LoginModel
@{
    ViewData["Title"] = "Login";
    Layout = "_LayoutLogin";
}

<div class="login-heading">
    <span class="login-eyebrow">Área segura</span>
    <h2>Boas-vindas</h2>
    <p>Entre com seus dados para acessar seu controle financeiro.</p>
</div>

@if (!string.IsNullOrEmpty(Model.MensagemErro))
{
    <div class="alert login-alert" role="alert"><i class="bi bi-exclamation-circle" aria-hidden="true"></i><span>@Model.MensagemErro</span></div>
}

<form method="post" autocomplete="off" class="login-form">
    <div asp-validation-summary="ModelOnly" class="text-danger login-validation"></div>
    <div class="login-field">
        <label asp-for="Input.Usuario" class="form-label">Usuário</label>
        <div class="login-input"><i class="bi bi-person" aria-hidden="true"></i><input asp-for="Input.Usuario" class="form-control" placeholder="Digite seu usuário" autocomplete="username" autofocus /></div>
        <span asp-validation-for="Input.Usuario" class="text-danger login-validation"></span>
    </div>
    <div class="login-field">
        <label asp-for="Input.Senha" class="form-label">Senha</label>
        <div class="login-input"><i class="bi bi-lock" aria-hidden="true"></i><input asp-for="Input.Senha" type="password" class="form-control" placeholder="Digite sua senha" autocomplete="current-password" /></div>
        <span asp-validation-for="Input.Senha" class="text-danger login-validation"></span>
    </div>

    <button type="submit" class="btn btn-login w-100">Entrar <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i></button>
</form>
<div class="login-security"><i class="bi bi-shield-check" aria-hidden="true"></i><span>Acesso protegido</span></div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
