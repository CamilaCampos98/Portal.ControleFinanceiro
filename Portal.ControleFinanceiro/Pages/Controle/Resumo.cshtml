@page
@attribute [Authorize]
@using System.Text.Json
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@model ResumoModel
@{
    var cultura = new CultureInfo("pt-BR");
    ViewData["Title"] = "Resumo por Pessoa e Período";

    var totaisPorCartao = new Dictionary<string, decimal>();

    if (Model.Resumo != null && Model.Resumo.ResumoPorCartaoTipo.Count > 0)
    {
         totaisPorCartao = Model.Resumo.ResumoPorCartaoTipo
            .GroupBy(x => string.IsNullOrWhiteSpace(x.Cartao) ? "Sem cartão" : x.Cartao)
            .ToDictionary(g => g.Key, g => g.Sum(x => x.Valor));
    }

    DateTime hoje = DateTime.Today;
    DateTime? dataMaisProxima = null;
    TimeSpan menorDiferenca = TimeSpan.MaxValue;

    if (Model.Resumo?.Compras != null)
    {
        foreach (var c in Model.Resumo.Compras)
        {
            if (c.TryGetValue("Data", out var objData))
            {
                DateTime dataCompra;

                if (objData is JsonElement jsonEl)
                {
                    // Se for string, tenta parsear
                    if (jsonEl.ValueKind == JsonValueKind.String && DateTime.TryParse(jsonEl.GetString(), out dataCompra))
                    {
                        var diferenca = (dataCompra - hoje).Duration();
                        if (diferenca < menorDiferenca)
                        {
                            menorDiferenca = diferenca;
                            dataMaisProxima = dataCompra;
                        }
                    }
                    // Se for número, tenta interpretar como ticks
                    else if (jsonEl.ValueKind == JsonValueKind.Number && jsonEl.TryGetInt64(out long ticks))
                    {
                        try
                        {
                            dataCompra = new DateTime(ticks);
                            var diferenca = (dataCompra - hoje).Duration();
                            if (diferenca < menorDiferenca)
                            {
                                menorDiferenca = diferenca;
                                dataMaisProxima = dataCompra;
                            }
                        }
                        catch
                        {
                            // Caso ticks estejam inválidos, ignora
                        }
                    }
                }
                // Caso objData já seja DateTime (raro nesse contexto)
                else if (objData is DateTime dt)
                {
                    var diferenca = (dt - hoje).Duration();
                    if (diferenca < menorDiferenca)
                    {
                        menorDiferenca = diferenca;
                        dataMaisProxima = dt;
                    }
                }
                // Caso objData seja string ou outro objeto
                else if (DateTime.TryParse(objData?.ToString(), out dataCompra))
                {
                    var diferenca = (dataCompra - hoje).Duration();
                    if (diferenca < menorDiferenca)
                    {
                        menorDiferenca = diferenca;
                        dataMaisProxima = dataCompra;
                    }
                }
            }
        }
    }

    decimal receitaTotal = 0m;
    decimal totalComprometido = 0m;
    decimal percentualComprometido = 0m;
    KeyValuePair<string, decimal>? maiorCartao = null;

    if (Model.Resumo != null)
    {
        receitaTotal = Model.Resumo.Salario + Model.Resumo.Extras;
        totalComprometido = Model.Resumo.TotalGasto + Model.Resumo.GastosFixos;
        percentualComprometido = receitaTotal > 0 ? (totalComprometido / receitaTotal) * 100 : 0;

        if (Model.Resumo.ResumoPorCartao != null && Model.Resumo.ResumoPorCartao.Any())
        {
            maiorCartao = Model.Resumo.ResumoPorCartao.OrderByDescending(x => x.Value).First();
        }
    }
}

<style>
	#gridResumo th.pago-col,
	#gridResumo td.pago-col {
		display: none;
	}

    .valor-sigiloso {
    filter: blur(5px);
    color: #6c757d; /* Cinza */
    cursor: pointer;
    transition: filter 0.3s ease, color 0.3s ease;
}

.valor-sigiloso.revelado {
    filter: none;
    color: inherit;
}
</style>

<div class="main-container">
    <h2><i class="bi bi-bar-chart-line"></i> Resumo por Pessoa e Período</h2>

    @if (!string.IsNullOrEmpty(Model.Mensagem))
        {
            <div class="alert @(Model.Sucesso ? "alert-success" : "alert-danger") alert-dismissible fade show shadow-sm mt-3" role="alert">
                <pre class="m-0">@Model.Mensagem</pre>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

    <!-- Formulário de Filtro -->
    <form method="post" class="mb-4">
        <div class="row g-3">
            <div class="col-sm-12 col-md-4">
                <label class="form-label">Pessoa</label>
                <input asp-for="Filtro.Pessoa" id="filtroPessoa" class="form-control" />
            </div>
            <div class="col-sm-6 col-md-4">
                <label class="form-label">Período</label>
                <input asp-for="Filtro.Periodo" id="filtroPeriodo" placeholder="Ex.: 05/2025" class="form-control" />
            </div>
        </div>

        <button type="submit" class="btn btn-success mt-3 responsive-button">
            <i class="bi bi-search"></i> Buscar Resumo
        </button>
    </form>

    @if (Model.Resumo != null)
    {
        <section class="summary-intelligence mb-4">
            <div class="metric-grid">
                <div class="metric-card">
                    <span class="metric-label">Receita total</span>
                    <strong class="valor-sigiloso" onclick="toggleTodos()">@receitaTotal.ToString("C", cultura)</strong>
                    <small>Salário + extras</small>
                </div>
                <div class="metric-card">
                    <span class="metric-label">Comprometido</span>
                    <strong class="valor-sigiloso" onclick="toggleTodos()">@totalComprometido.ToString("C", cultura)</strong>
                    <small>@percentualComprometido.ToString("N1")% da receita</small>
                </div>
                <div class="metric-card @(Model.Resumo.SaldoRestante < 0 ? "metric-danger" : Model.Resumo.SaldoCritico ? "metric-warning" : "metric-good")">
                    <span class="metric-label">Saldo previsto</span>
                    <strong class="valor-sigiloso" onclick="toggleTodos()">@Model.Resumo.SaldoRestante.ToString("C", cultura)</strong>
                    <small>@(Model.Resumo.SaldoRestante < 0 ? "Fechamento negativo" : "Após fixos e compras")</small>
                </div>
                <div class="metric-card">
                    <span class="metric-label">Competência</span>
                    <strong>@Model.Resumo.Periodo</strong>
                    <small>Cada cartão respeita seu próprio fechamento</small>
                </div>
            </div>

            <div class="insight-list mt-3">
                @if (Model.Resumo.SaldoRestante < 0)
                {
                    <div class="insight insight-danger">
                        <i class="bi bi-exclamation-triangle"></i>
                        <span>O período está projetado para fechar negativo. Revise compras recentes e fixos pendentes.</span>
                    </div>
                }
                else if (Model.Resumo.SaldoCritico || percentualComprometido >= 80)
                {
                    <div class="insight insight-warning">
                        <i class="bi bi-activity"></i>
                        <span>@percentualComprometido.ToString("N1")% da receita já está comprometida. Vale reduzir compras variáveis até o fechamento.</span>
                    </div>
                }
                else
                {
                    <div class="insight insight-good">
                        <i class="bi bi-check2-circle"></i>
                        <span>O período ainda está saudável. Acompanhe o saldo previsto, pois cada cartão possui sua própria data de fechamento.</span>
                    </div>
                }

                @if (maiorCartao.HasValue && Model.Resumo.TotalGasto > 0)
                {
                    var pesoCartao = (maiorCartao.Value.Value / Model.Resumo.TotalGasto) * 100;
                    <div class="insight">
                        <i class="bi bi-credit-card-2-front"></i>
                        <span>Maior concentração: @maiorCartao.Value.Key com @maiorCartao.Value.Value.ToString("C", cultura) (@pesoCartao.ToString("N1")% dos gastos variáveis).</span>
                    </div>
                }
            </div>

            @if (Model.Resumo.ResumoPorCartao != null && Model.Resumo.ResumoPorCartao.Any())
            {
                <div class="card-summary-strip mt-3">
                    @foreach (var item in Model.Resumo.ResumoPorCartao.OrderByDescending(x => x.Value))
                    {
                        <div class="card-summary-item">
                            <span>@item.Key</span>
                            <strong class="valor-sigiloso" onclick="toggleTodos()">@item.Value.ToString("C", cultura)</strong>
                        </div>
                    }
                </div>
            }
        </section>

        <div class="card shadow-sm mb-4">
            <div class="card-header card-header-custom purchase-card-header">
                <h5 class="mb-0">
                    <i class="bi bi-cart-check"></i> Compras de <strong>@Model.Resumo.Pessoa</strong>
                </h5>
                <button type="button" class="btn btn-light btn-sm" data-bs-toggle="modal" data-bs-target="#modalRegistrarCompraResumo">
                    <i class="bi bi-cart-plus"></i> Nova compra
                </button>
            </div>

            <div class="card-body">
               <div class="card-body">
                    <div class="row mb-3">
                         <div class="col-12 col-md"><strong>Período:</strong> @Model.Resumo.Periodo</div>
         
                         <div class="col-12 col-md"><strong>Salário:</strong> 
                             <span class="valor-sigiloso" onclick="toggleTodos()">
                                 @Model.Resumo.Salario.ToString("C", cultura)
                             </span>
                         </div>

                         <div class="col-12 col-md"><strong>Extras:</strong> 
                             <span class="valor-sigiloso" onclick="toggleTodos()">
                                 @Model.Resumo.Extras.ToString("C", cultura)
                             </span>
                         </div>

                         <div class="col-12 col-md"><strong>Gastos Fixos:</strong> 
                             <span class="valor-sigiloso" onclick="toggleTodos()">
                                 @Model.Resumo.GastosFixos.ToString("C", cultura)
                             </span>
                         </div>

                         <div class="col-12 col-md"><strong>Total Gasto:</strong> 
                             <span class="valor-sigiloso" onclick="toggleTodos()">
                                 @Model.Resumo.TotalGasto.ToString("C", cultura)
                             </span>
                         </div>

                         <div class="col-12 col-md">
                             <strong>Saldo:</strong> 
                             <span class="valor-sigiloso @(Model.Resumo.SaldoCritico ? "text-danger fw-bold" : "fw-bold text-success")" 
                                   onclick="toggleTodos()">
                                 @Model.Resumo.SaldoRestante.ToString("C", cultura)
                             </span>
                         </div>
                     </div>
                </div>


                
                    <button type="button" class="btn btn-primary mb-3" data-bs-toggle="modal" data-bs-target="#modalResumoPorCartao">
                        <i class="bi bi-credit-card-2-front"></i> Resumo por Cartão
                    </button>
                    <div class="text-end mb-2">
			            <button id="btnTogglePago"
					            type="button"
					            class="btn btn-outline-secondary btn-sm">
				            <i class="bi bi-eye-slash" id="iconTogglePago"></i> Mostrar Valor
			            </button>
		            </div>
                

                @if (Model.Resumo.Compras.Any())
                {
                    <form id="formExcluir" method="post" asp-page-handler="Excluir">
                    	<input type="hidden" name="Id" id="formExcluir_Id" />
	                    <input type="hidden" name="MesAno" id="formExcluir_MesAno" />
                    </form>

                    <div class="table-tools mb-3">
                        <div>
                            <label class="form-label" for="filtroTabelaTexto">Buscar</label>
                            <input id="filtroTabelaTexto" type="search" class="form-control" placeholder="Compra, cartão, forma..." />
                        </div>
                        <div>
                            <label class="form-label" for="filtroTabelaCartao">Cartão</label>
                            <select id="filtroTabelaCartao" class="form-select">
                                <option value="">Todos</option>
                                @foreach (var cartao in Model.Resumo.Compras
                                    .Select(c => c.TryGetValue("Cartao", out var v) ? v?.ToString() : "")
                                    .Where(c => !string.IsNullOrWhiteSpace(c))
                                    .Distinct(StringComparer.OrdinalIgnoreCase)
                                    .OrderBy(c => c))
                                {
                                    <option value="@cartao">@cartao</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="form-label" for="filtroTabelaPagamento">Pagamento</label>
                            <select id="filtroTabelaPagamento" class="form-select">
                                <option value="">Todos</option>
                                @foreach (var forma in Model.Resumo.Compras
                                    .Select(c => c.TryGetValue("FormaPgto", out var v) ? v?.ToString() : "")
                                    .Where(c => !string.IsNullOrWhiteSpace(c))
                                    .Distinct(StringComparer.OrdinalIgnoreCase)
                                    .OrderBy(c => c))
                                {
                                    <option value="@forma">@forma</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="form-label" for="filtroTabelaValorMinimo">Valor mínimo</label>
                            <input id="filtroTabelaValorMinimo" type="number" min="0" step="0.01" class="form-control" placeholder="0,00" />
                        </div>
                    </div>

                    <div class="table-filter-status mb-2" id="tableFilterStatus"></div>

                    <div class="table-responsive">
                        <table class="table table-bordered table-hover align-middle" id="gridResumo">
                            <thead>
                                <tr class="text-center">
                                    <th>ID</th>
                                    <th>Data</th>
                                    <th>Compra</th>
                                    <th class="pago-col" style="min-width: 120px;">Valor (R$)</th>
                                    <th>Forma Pgto</th>
                                    <th>Cartao</th>
                                    <th>Parcela</th>
                                    <th>Mês/Ano</th>
                                    <th style="display:none">Fonte</th>
                                    <th>Ações</th>
                                    
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in Model.Resumo.Compras)
                                {
                                    decimal valor = 0m;

                                    if (c["Valor"] is JsonElement el && el.ValueKind == JsonValueKind.Number)
                                    {
                                        valor = el.GetDecimal();
                                    }
                                    else if (c["Valor"] is JsonElement elStr && elStr.ValueKind == JsonValueKind.String)
                                    {
                                        // Caso venha como string, tenta parsear usando pt-BR
                                        if (decimal.TryParse(elStr.GetString(), NumberStyles.Number, new CultureInfo("pt-BR"), out var valParsed))
                                        {
                                            valor = valParsed;
                                        }
                                    }

                                    // Extrair dataAtualLinha da compra para usar na comparação
                                    DateTime dataAtualLinha = DateTime.MinValue;
                                    if (c.TryGetValue("Data", out var objData))
                                    {
                                        if (objData is JsonElement jsonEl)
                                        {
                                            if (jsonEl.ValueKind == JsonValueKind.String && DateTime.TryParse(jsonEl.GetString(), out var dt))
                                            {
                                                dataAtualLinha = dt;
                                            }
                                            else if (jsonEl.ValueKind == JsonValueKind.Number && jsonEl.TryGetInt64(out long ticks))
                                            {
                                                try
                                                {
                                                    dataAtualLinha = new DateTime(ticks);
                                                }
                                                catch { }
                                            }
                                        }
                                        else if (objData is DateTime dt)
                                        {
                                            dataAtualLinha = dt;
                                        }
                                        else if (DateTime.TryParse(objData?.ToString(), out var dt1))
                                        {
                                            dataAtualLinha = dt1;
                                        }
                                    }
                                    
                                    <tr class="text-center @(dataAtualLinha.Date == dataMaisProxima?.Date ? "table-primary linha-alvo" : "")">
                                        <td>@c["IdLan"]</td>
                                        <td>@DateTime.Parse(c["Data"].ToString()).ToString("dd/MM/yyyy")</td>
                                        <td class="text-start">@c["Compra"]</td>
                                        <td class="pago-col">R$ @valor.ToString("N2")</td>
                                        <td>@c["FormaPgto"]</td>
                                        <td>@c["Cartao"]</td>
                                        <td>@c["Parcela"]</td>
                                        <td>@c["MesAno"]</td>
                                        <td style="display:none">@c["Fonte"]</td>
                                        <td>
                                            <button class="btn btn-sm btn-warning"
                                                    onclick="editarCompra('@c["IdLan"]')">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>

                                             <button type="button"
												form="formExcluir"
												class="btn btn-secondary btn-sm"
												onclick="confirmarExcluir('@c["IdLan"]', '@c["MesAno"]');">
											<i class="bi bi-trash"></i>
										</button>
                                        </td>
                                        
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Paginação -->
                    <nav aria-label="Paginação de compras">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(Model.PaginaAtual == 1 ? "disabled" : "")">
                                <a class="page-link" asp-route-pagina="@(Model.PaginaAtual - 1)">Anterior</a>
                            </li>

                            @for (int i = 1; i <= Model.TotalPaginas; i++)
                            {
                                <li class="page-item @(i == Model.PaginaAtual ? "active" : "")">
                                    <a class="page-link" asp-route-pagina="@i">@i</a>
                                </li>
                            }

                            <li class="page-item @(Model.PaginaAtual == Model.TotalPaginas ? "disabled" : "")">
                                <a class="page-link" asp-route-pagina="@(Model.PaginaAtual + 1)">Próxima</a>
                            </li>
                        </ul>
                    </nav>

                    <div class="modal fade" id="modalEditarCompra" tabindex="-1" aria-labelledby="modalEditarCompraLabel" aria-hidden="true">
                      <div class="modal-dialog">
                        <div class="modal-content">
                          <form id="formEditarCompra" method="post" asp-page-handler="Editar">
                            <div class="modal-header">
                              <h5 class="modal-title" id="modalEditarCompraLabel">
                                <i class="bi bi-pencil-square"></i> Editar Compra
                              </h5>
                              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                            </div>
                            <div class="modal-body">
                              <!-- Campo escondido para IdLan -->
                              <input type="hidden" id="editIdLan" name="Compra.IdLan" />

                              <div class="mb-3">
                                <label class="form-label">Pessoa</label>
                                <input type="text" class="form-control" id="editPessoa" name="Compra.Pessoa" required />
                              </div>
                              <div class="mb-3">
                                <label class="form-label">Compra</label>
                                <input type="text" class="form-control" id="editCompra" name="Compra.Compra" required />
                              </div>

                              <div class="mb-3">
                                <label class="form-label">Valor (R$)</label>
                                <input type="number" step="0.01" class="form-control" id="editValor" name="Compra.Valor" required />
                              </div>

                              <div class="mb-3">
                                <label class="form-label">Forma Pgto</label>
                                <input type="text" class="form-control" id="editFormaPgto" name="Compra.FormaPgto" />
                              </div>

                              <div class="mb-3">
                                <label class="form-label">Cartão</label>
                                <input type="text" class="form-control" id="editCartao" name="Compra.Cartao" />
                              </div>

                              <div class="mb-3">
                                <label class="form-label">Parcela</label>
                                <input type="text" class="form-control" id="editParcela" name="Compra.Parcela" />
                              </div>

                              <div class="mb-3">
                               <label class="form-label">Data</label>
                               <input type="date" class="form-control" id="editData" name="Compra.Data" />
                             </div>
                            </div>
                            <div class="modal-footer">
                              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                              <button type="submit" class="btn btn-success">Salvar Alterações</button>
                            </div>
                          </form>
                        </div>
                      </div>
                    </div>

                    <div class="modal fade" id="modalRegistrarCompraResumo" tabindex="-1" aria-labelledby="modalRegistrarCompraResumoLabel" aria-hidden="true">
                        <div class="modal-dialog modal-lg modal-dialog-centered modal-fullscreen-sm-down">
                            <div class="modal-content">
                                <form method="post" asp-page-handler="RegistrarCompra" id="formNovaCompraResumo" novalidate>
                                    <div class="modal-header">
                                        <div>
                                            <h5 class="modal-title" id="modalRegistrarCompraResumoLabel">
                                                <i class="bi bi-cart-plus"></i> Registrar compra
                                            </h5>
                                            <small class="text-muted">@Model.Resumo.Pessoa · Resumo pesquisado: @Model.Resumo.Periodo</small>
                                        </div>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                                    </div>
                                    <div class="modal-body">
                                        @if (!string.IsNullOrWhiteSpace(Model.ErroNovaCompra))
                                        {
                                            <div class="alert alert-danger d-flex align-items-start gap-2" role="alert">
                                                <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                                                <span>@Model.ErroNovaCompra</span>
                                            </div>
                                        }

                                        <div id="novaCompraCampos" class="row g-3">
                                            <div class="col-md-6">
                                                <label class="form-label" for="novaCompraPessoa">Pessoa</label>
                                                <input id="novaCompraPessoa" class="form-control" value="@Model.Resumo.Pessoa" readonly aria-readonly="true" />
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label" asp-for="NovaCompra.Descricao">Descrição <span class="required-mark">*</span></label>
                                                <input asp-for="NovaCompra.Descricao" class="form-control" required autofocus />
                                                <span asp-validation-for="NovaCompra.Descricao" class="invalid-feedback d-block"></span>
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label" asp-for="NovaCompra.ValorTotal">Valor (R$) <span class="required-mark">*</span></label>
                                                <input asp-for="NovaCompra.ValorTotal" type="number" min="0.01" step="0.01" class="form-control" required />
                                                <small id="novaCompraValorFormatado" class="form-text">R$ 0,00</small>
                                                <span asp-validation-for="NovaCompra.ValorTotal" class="invalid-feedback d-block"></span>
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label" asp-for="NovaCompra.Data">Data da compra <span class="required-mark">*</span></label>
                                                <input asp-for="NovaCompra.Data" type="date" class="form-control" required />
                                                <span asp-validation-for="NovaCompra.Data" class="invalid-feedback d-block"></span>
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label" asp-for="NovaCompra.FormaPgto">Forma de pagamento <span class="required-mark">*</span></label>
                                                <select asp-for="NovaCompra.FormaPgto" id="novaCompraFormaPgto" class="form-select" required>
                                                    <option value="C">Crédito</option>
                                                    <option value="D">Débito</option>
                                                </select>
                                                <span asp-validation-for="NovaCompra.FormaPgto" class="invalid-feedback d-block"></span>
                                            </div>
                                            <div class="col-md-4" id="novaCompraCartaoContainer">
                                                <label class="form-label" asp-for="NovaCompra.Cartao">Cartão <span class="required-mark">*</span></label>
                                                <select asp-for="NovaCompra.Cartao" id="novaCompraCartao" class="form-select">
                                                    <option value="">Selecione...</option>
                                                </select>
                                                <span asp-validation-for="NovaCompra.Cartao" class="invalid-feedback d-block"></span>
                                                <small id="novaCompraCartaoErro" class="text-danger d-none" role="alert"></small>
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label" asp-for="NovaCompra.TotalParcelas">Parcelas <span class="required-mark">*</span></label>
                                                <input asp-for="NovaCompra.TotalParcelas" type="number" min="1" class="form-control" required />
                                                <small class="form-text">Use 1 para compra à vista.</small>
                                                <span asp-validation-for="NovaCompra.TotalParcelas" class="invalid-feedback d-block"></span>
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label" asp-for="NovaCompra.Fonte">Fonte <span class="required-mark">*</span></label>
                                                <input asp-for="NovaCompra.Fonte" class="form-control" list="fontesNovaCompra" autocomplete="off" required />
                                                <datalist id="fontesNovaCompra">
                                                    @foreach (var fonte in Model.Resumo.Compras
                                                        .Select(c => c.TryGetValue("Fonte", out var valorFonte) ? valorFonte?.ToString() : null)
                                                        .Where(f => !string.IsNullOrWhiteSpace(f))
                                                        .Distinct(StringComparer.OrdinalIgnoreCase)
                                                        .OrderBy(f => f))
                                                    {
                                                        <option value="@fonte"></option>
                                                    }
                                                </datalist>
                                                <span asp-validation-for="NovaCompra.Fonte" class="invalid-feedback d-block"></span>
                                            </div>

                                            <div class="col-12">
                                                <div id="novaCompraPeriodoStatus" class="period-preview" role="status" aria-live="polite">
                                                    <i class="bi bi-calendar-event" aria-hidden="true"></i>
                                                    <span>Preencha data e cartão para conferir o período de contabilização.</span>
                                                </div>
                                            </div>
                                        </div>

                                        <section id="novaCompraRevisao" class="purchase-review d-none" aria-labelledby="novaCompraRevisaoTitulo">
                                            <h6 id="novaCompraRevisaoTitulo">Confira antes de registrar</h6>
                                            <div id="novaCompraRevisaoConteudo"></div>
                                        </section>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                                        <button type="button" class="btn btn-outline-secondary d-none" id="btnVoltarNovaCompra">
                                            <i class="bi bi-arrow-left"></i> Voltar
                                        </button>
                                        <button type="button" class="btn btn-primary" id="btnRevisarNovaCompra">
                                            <i class="bi bi-eye"></i> Revisar compra
                                        </button>
                                        <button type="submit" class="btn btn-success d-none" id="btnConfirmarNovaCompra">
                                            <span class="spinner-border spinner-border-sm d-none" aria-hidden="true"></span>
                                            <i class="bi bi-check-circle"></i>
                                            <span class="submit-label">Confirmar registro</span>
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>

                    <div class="modal fade" id="modalResumoPorCartao" tabindex="-1" aria-labelledby="modalResumoPorCartaoLabel" aria-hidden="true">
                        <div class="modal-dialog modal-xl modal-dialog-centered">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="modalResumoPorCartaoLabel">
                                        <i class="bi bi-credit-card-2-front"></i> Resumo por Cartão
                                    </h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                                </div>

                                <div class="modal-body card-reconcile-modal">
                                    @{
                                        var gruposCartao = Model.Resumo.ResumoPorCartaoTipo
                                            .GroupBy(x => string.IsNullOrWhiteSpace(x.Cartao) ? "Sem cartão" : x.Cartao)
                                            .Select(g => new
                                            {
                                                Cartao = g.Key,
                                                Total = g.Sum(x => x.Valor),
                                                Tipos = g.OrderBy(x => x.Tipo).ToList()
                                            })
                                            .OrderByDescending(x => x.Total)
                                            .ToList();

                                        var totalGeralCartoes = gruposCartao.Sum(x => x.Total);
                                    }

                                    <div class="reconcile-summary">
                                        <div>
                                            <span>Cartões na conferência</span>
                                            <strong>@gruposCartao.Count</strong>
                                        </div>
                                        <div>
                                            <span>Total geral</span>
                                            <strong>@totalGeralCartoes.ToString("C", cultura)</strong>
                                        </div>
                                    </div>

                                    <div class="reconcile-grid">
                                        @foreach (var grupo in gruposCartao)
                                        {
                                            <section class="reconcile-card">
                                                <div class="reconcile-card__header">
                                                    <div>
                                                        <span>Cartão</span>
                                                        <strong>@grupo.Cartao</strong>
                                                    </div>
                                                    <div class="text-end">
                                                        <span>Total da fatura</span>
                                                        <strong>@grupo.Total.ToString("C", cultura)</strong>
                                                    </div>
                                                </div>

                                                <div class="reconcile-lines">
                                                    @foreach (var item in grupo.Tipos)
                                                    {
                                                        var percentual = grupo.Total > 0 ? (item.Valor / grupo.Total) * 100 : 0;
                                                        var largura = percentual.ToString("0.##", CultureInfo.InvariantCulture);
                                                        var tipo = string.IsNullOrWhiteSpace(item.Tipo) ? "Sem tipo" : item.Tipo;

                                                        <div class="reconcile-line">
                                                            <div class="reconcile-line__meta">
                                                                <span>@tipo</span>
                                                                <strong>@item.Valor.ToString("C", cultura)</strong>
                                                            </div>
                                                            <div class="reconcile-bar" aria-label="@tipo representa @percentual.ToString("N1", cultura)% do cartão">
                                                                <span style="width: @largura%"></span>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>

                                                <div class="reconcile-total">
                                                    <span>Total para conferir na fatura</span>
                                                    <strong>@grupo.Total.ToString("C", cultura)</strong>
                                                </div>
                                            </section>
                                        }
                                    </div>
                                </div>

                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                        <i class="bi bi-x-circle"></i> Fechar
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning">
                        Nenhuma compra encontrada neste período.
                    </div>
                }

                <!-- Botão de limpar -->
                <form method="post" asp-page-handler="LimparSessao">
                    <button type="submit" class="btn btn-danger mt-3 responsive-button">
                        <i class="bi bi-x-circle"></i> Limpar Resumo
                    </button>
                </form>
            </div>
            
        </div>


    }

</div>
<div class="loading-overlay" id="loadingOverlay">
	<div>
		<div class="spinner-border text-primary" role="status"></div>
	</div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/choices.js/public/assets/styles/choices.min.css" />
<script src="https://cdn.jsdelivr.net/npm/choices.js/public/assets/scripts/choices.min.js"></script>
<script src="https://unpkg.com/imask"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
@* <script src="~/js/resumo.js"></script> *@

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', async function () {
            const modalElement = document.getElementById('modalRegistrarCompraResumo');
            const form = document.getElementById('formNovaCompraResumo');
            const formaPgto = document.getElementById('novaCompraFormaPgto');
            const cartaoContainer = document.getElementById('novaCompraCartaoContainer');
            const cartaoSelect = document.getElementById('novaCompraCartao');
            const cartaoErro = document.getElementById('novaCompraCartaoErro');
            const parcelas = document.getElementById('NovaCompra_TotalParcelas');
            const valor = document.getElementById('NovaCompra_ValorTotal');
            const dataCompra = document.getElementById('NovaCompra_Data');
            const periodoStatus = document.getElementById('novaCompraPeriodoStatus');
            const campos = document.getElementById('novaCompraCampos');
            const revisao = document.getElementById('novaCompraRevisao');
            const revisaoConteudo = document.getElementById('novaCompraRevisaoConteudo');
            const btnRevisar = document.getElementById('btnRevisarNovaCompra');
            const btnVoltar = document.getElementById('btnVoltarNovaCompra');
            const btnConfirmar = document.getElementById('btnConfirmarNovaCompra');
            const urlApiResumo = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.UrlApi));
            const pessoaResumo = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Resumo?.Pessoa ?? string.Empty));
            const periodoResumo = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Resumo?.Periodo ?? string.Empty));
            const abrirModalNovaCompra = @Html.Raw(Model.AbrirModalNovaCompra ? "true" : "false");
            let periodoCalculado = '';
            let carregandoCartoes = true;

            if (!modalElement || !form || !formaPgto || !cartaoContainer || !cartaoSelect) return;

            function atualizarObrigatoriedadeCartao() {
                const usaCredito = formaPgto.value === 'C';
                cartaoContainer.style.display = usaCredito ? '' : 'none';
                cartaoSelect.required = usaCredito;
                parcelas.readOnly = !usaCredito;
                if (!usaCredito) {
                    cartaoSelect.value = '';
                    parcelas.value = '1';
                }
                conferirPeriodo();
            }

            formaPgto.addEventListener('change', atualizarObrigatoriedadeCartao);
            dataCompra?.addEventListener('change', conferirPeriodo);
            cartaoSelect.addEventListener('change', conferirPeriodo);
            valor?.addEventListener('input', function () {
                const numero = Number(valor.value || 0);
                document.getElementById('novaCompraValorFormatado').textContent = numero.toLocaleString('pt-BR', {
                    style: 'currency',
                    currency: 'BRL'
                });
            });

            try {
                const response = await fetch(urlApiResumo + 'Compra/GetCartoes');
                if (!response.ok) throw new Error('Erro ao buscar cartões.');

                const cartaoSelecionado = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.NovaCompra.Cartao));
                const cartoes = await response.json();

                cartoes.forEach(cartao => {
                    const option = document.createElement('option');
                    option.value = cartao;
                    option.textContent = cartao;
                    option.selected = cartao === cartaoSelecionado;
                    cartaoSelect.appendChild(option);
                });
            } catch (error) {
                cartaoErro.textContent = 'Não foi possível carregar os cartões. Feche o modal e tente novamente.';
                cartaoErro.classList.remove('d-none');
                cartaoSelect.disabled = true;
                btnRevisar.disabled = true;
            } finally {
                carregandoCartoes = false;
                atualizarObrigatoriedadeCartao();
            }

            async function conferirPeriodo() {
                periodoCalculado = '';

                if (!dataCompra?.value) {
                    atualizarPeriodoStatus('Preencha a data para conferir o período de contabilização.', false);
                    return;
                }

                if (formaPgto.value !== 'C') {
                    const [ano, mes] = dataCompra.value.split('-');
                    periodoCalculado = `${mes}/${ano}`;
                    atualizarPeriodoStatus(`Compra no débito. Referência da data: ${periodoCalculado}.`, false);
                    return;
                }

                if (!cartaoSelect.value || carregandoCartoes) {
                    atualizarPeriodoStatus('Selecione o cartão para conferir o período de contabilização.', false);
                    return;
                }

                atualizarPeriodoStatus('Conferindo o período da compra…', false);
                const data = new Date(`${dataCompra.value}T12:00:00`);
                const candidatos = [0, -1, 1];

                try {
                    for (const deslocamento of candidatos) {
                        const referencia = new Date(data.getFullYear(), data.getMonth() + deslocamento, 1);
                        const mesAno = `${String(referencia.getMonth() + 1).padStart(2, '0')}/${referencia.getFullYear()}`;
                        const url = urlApiResumo + 'Compra/PeriodoFatura'
                            + `?pessoa=${encodeURIComponent(pessoaResumo)}`
                            + `&mesAno=${encodeURIComponent(mesAno)}`
                            + `&cartao=${encodeURIComponent(cartaoSelect.value)}`;
                        const response = await fetch(url);
                        if (!response.ok) continue;

                        const periodo = await response.json();
                        const inicio = new Date(periodo.inicio);
                        const fim = new Date(periodo.fim);
                        if (data >= inicio && data <= fim) {
                            periodoCalculado = mesAno;
                            const diverge = mesAno !== periodoResumo;
                            atualizarPeriodoStatus(
                                diverge
                                    ? `Atenção: esta compra será contabilizada em ${mesAno}, fora do resumo pesquisado.`
                                    : `Esta compra será contabilizada em ${mesAno}.`,
                                diverge);
                            return;
                        }
                    }

                    atualizarPeriodoStatus('Não foi possível identificar o período. Revise data e cartão.', true);
                } catch (error) {
                    atualizarPeriodoStatus('Não foi possível conferir o período agora.', true);
                }
            }

            function atualizarPeriodoStatus(texto, alerta) {
                periodoStatus.querySelector('span').textContent = texto;
                periodoStatus.classList.toggle('period-preview--warning', alerta);
            }

            function exibirCampos() {
                campos.classList.remove('d-none');
                revisao.classList.add('d-none');
                btnRevisar.classList.remove('d-none');
                btnVoltar.classList.add('d-none');
                btnConfirmar.classList.add('d-none');
            }

            async function prepararRevisao() {
                form.classList.add('was-validated');
                if (!form.checkValidity()) {
                    form.querySelector(':invalid')?.focus();
                    return;
                }

                await conferirPeriodo();
                const descricao = document.getElementById('NovaCompra_Descricao').value;
                const fonte = document.getElementById('NovaCompra_Fonte').value;
                const valorFormatado = Number(valor.value).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
                const pagamento = formaPgto.value === 'C' ? 'Crédito' : 'Débito';
                const detalheCartao = formaPgto.value === 'C' ? ` · ${cartaoSelect.value}` : '';
                const detalheParcelas = formaPgto.value === 'C' ? ` · ${parcelas.value} parcela(s)` : '';

                revisaoConteudo.innerHTML = `
                    <strong>${escaparHtml(descricao)}</strong>
                    <span>${valorFormatado}</span>
                    <span>${formatarDataCompra(dataCompra.value)}</span>
                    <span>${pagamento}${escaparHtml(detalheCartao)}${detalheParcelas}</span>
                    <span>Fonte: ${escaparHtml(fonte)}</span>
                    <span>Período: ${periodoCalculado || 'a confirmar no registro'}</span>`;

                campos.classList.add('d-none');
                revisao.classList.remove('d-none');
                btnRevisar.classList.add('d-none');
                btnVoltar.classList.remove('d-none');
                btnConfirmar.classList.remove('d-none');
                btnConfirmar.focus();
            }

            btnRevisar.addEventListener('click', prepararRevisao);
            btnVoltar.addEventListener('click', exibirCampos);
            form.addEventListener('submit', function (event) {
                if (revisao.classList.contains('d-none')) {
                    event.preventDefault();
                    prepararRevisao();
                    return;
                }

                btnConfirmar.disabled = true;
                btnConfirmar.querySelector('.spinner-border').classList.remove('d-none');
                btnConfirmar.querySelector('.bi').classList.add('d-none');
                btnConfirmar.querySelector('.submit-label').textContent = 'Registrando…';
            });

            modalElement.addEventListener('shown.bs.modal', function () {
                modalElement.querySelector('[autofocus]')?.focus();
            });

            if (abrirModalNovaCompra) {
                bootstrap.Modal.getOrCreateInstance(modalElement).show();
            }

            function escaparHtml(valor) {
                const elemento = document.createElement('div');
                elemento.textContent = valor || '';
                return elemento.innerHTML;
            }

            function formatarDataCompra(valor) {
                if (!valor) return '';
                const [ano, mes, dia] = valor.split('-');
                return `${dia}/${mes}/${ano}`;
            }
        });
      
        async function confirmarExcluir(id, mesAno) {
            const resultado = await Swal.fire({
                title: 'Tem certeza?',
                html: `Deseja realmente excluir o ID <strong>${id}</strong> do mês <strong>${mesAno}</strong>?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Sim, excluir',
                cancelButtonText: 'Cancelar',
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6'
            });

            if (resultado.isConfirmed) {
                document.getElementById('formExcluir_Id').value = id;
                document.getElementById('formExcluir_MesAno').value = mesAno;
                document.getElementById('formExcluir').submit(); // envia o form
            }
        }

        window.addEventListener("DOMContentLoaded", function () {
            const alvo = document.querySelector(".linha-alvo");
            if (alvo) {
                alvo.scrollIntoView({ behavior: "smooth", block: "center" });
            }
        });

        window.onload = function () {
            var elemento = document.getElementById('filtroPeriodo');
            if (elemento) {
                IMask(elemento, {
                    mask: '00/0000',
                    placeholderChar: '_',
                });
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            const overlay = document.getElementById('loadingOverlay');

            const forms = document.querySelectorAll('form');
            forms.forEach(form => {
                form.addEventListener('submit', function (event) {
                    if (event.defaultPrevented) return;

                    // Ativa overlay
                    overlay.style.display = 'flex';

                    // Ativa loading nos botões do formulário
                    const btns = form.querySelectorAll('button[type="submit"]');
                    btns.forEach(btn => {
                        btn.classList.add('btn-loading');
                    });
                });
            });
        });

        document.addEventListener('DOMContentLoaded', function () {
            const btn = document.getElementById('btnTogglePago');
            const icon = document.getElementById('iconTogglePago');
            let isVisible = false;

            if (!btn) return;

            btn.addEventListener('click', function () {
                const ths = document.querySelectorAll('#gridResumo th.pago-col');
                const tds = document.querySelectorAll('#gridResumo td.pago-col');

                isVisible = !isVisible;

                ths.forEach(th => {
                    th.style.display = isVisible ? 'table-cell' : 'none';
                });

                tds.forEach(td => {
                    td.style.display = isVisible ? 'table-cell' : 'none';
                });

                if (isVisible) {
                    icon.classList.remove('bi-eye-slash');
                    icon.classList.add('bi-eye');
                    btn.innerHTML = '<i class="bi bi-eye" id="iconTogglePago"></i> Ocultar Valor';
                } else {
                    icon.classList.remove('bi-eye');
                    icon.classList.add('bi-eye-slash');
                    btn.innerHTML = '<i class="bi bi-eye-slash" id="iconTogglePago"></i> Mostrar Valor';
                }
            });
        });

        document.addEventListener('DOMContentLoaded', function () {
            const table = document.getElementById('gridResumo');
            if (!table) return;

            const search = document.getElementById('filtroTabelaTexto');
            const cartao = document.getElementById('filtroTabelaCartao');
            const pagamento = document.getElementById('filtroTabelaPagamento');
            const valorMinimo = document.getElementById('filtroTabelaValorMinimo');
            const status = document.getElementById('tableFilterStatus');
            const rows = Array.from(table.querySelectorAll('tbody tr'));

            function parseMoney(text) {
                return Number((text || '')
                    .replace('R$', '')
                    .replace(/\s/g, '')
                    .replace(/\./g, '')
                    .replace(',', '.')) || 0;
            }

            function applyFilters() {
                const query = (search?.value || '').trim().toLowerCase();
                const selectedCartao = (cartao?.value || '').trim().toLowerCase();
                const selectedPagamento = (pagamento?.value || '').trim().toLowerCase();
                const minimum = Number((valorMinimo?.value || '').replace(',', '.')) || 0;
                let visible = 0;

                rows.forEach(row => {
                    const cells = row.children;
                    const descricao = cells[2]?.textContent?.trim().toLowerCase() || '';
                    const valor = parseMoney(cells[3]?.textContent || '');
                    const forma = cells[4]?.textContent?.trim().toLowerCase() || '';
                    const cartaoLinha = cells[5]?.textContent?.trim().toLowerCase() || '';
                    const fonte = cells[8]?.textContent?.trim().toLowerCase() || '';
                    const searchable = `${descricao} ${forma} ${cartaoLinha} ${fonte}`;

                    const matches =
                        (!query || searchable.includes(query)) &&
                        (!selectedCartao || cartaoLinha === selectedCartao) &&
                        (!selectedPagamento || forma === selectedPagamento) &&
                        (!minimum || valor >= minimum);

                    row.style.display = matches ? '' : 'none';
                    if (matches) visible++;
                });

                if (status) {
                    status.textContent = visible === rows.length
                        ? `${visible} compra(s) nesta página`
                        : `${visible} de ${rows.length} compra(s) nesta página`;
                }
            }

            [search, cartao, pagamento, valorMinimo].forEach(input => {
                input?.addEventListener('input', applyFilters);
                input?.addEventListener('change', applyFilters);
            });

            applyFilters();
        });

        function toggleTodos() {
            const valores = document.querySelectorAll('.valor-sigiloso');
            const algumRevelado = Array.from(valores).some(v => v.classList.contains('revelado'));

            valores.forEach(v => {
                if (algumRevelado) {
                    v.classList.remove('revelado');
                } else {
                    v.classList.add('revelado');
                }
            });
        }

        function editarCompra(idLan) {
            const row = Array.from(document.querySelectorAll('#gridResumo tbody tr'))
                .find(tr => tr.children[0].innerText == idLan);

            const pessoa = document.getElementById('filtroPessoa').value;

            if (row) {
                const dadosCompra = {
                    idLan: idLan,
                    pessoa: pessoa,
                    compra: row.children[2].textContent,
                    valor: parseFloat(row.children[3].textContent.replace('R$', '').trim().replace('.', '').replace(',', '.')),
                    formaPgto: row.children[4].textContent,
                    cartao: row.children[5].textContent,
                    parcela: row.children[6].textContent,
                    data: row.children[1].textContent
                };

                abrirModalEditarCompra(dadosCompra);
            }
        }


        function abrirModalEditarCompra(dadosCompra) {
            document.getElementById('editIdLan').value = dadosCompra.idLan || '';
            document.getElementById('editCompra').value = dadosCompra.compra || '';
            document.getElementById('editPessoa').value = dadosCompra.pessoa || '';
            document.getElementById('editValor').value = dadosCompra.valor ?? '';
            document.getElementById('editFormaPgto').value = dadosCompra.formaPgto || '';
            document.getElementById('editCartao').value = dadosCompra.cartao || '';
            document.getElementById('editParcela').value = dadosCompra.parcela || '';

            // Tratamento da data
            let dataFormatada = '';
            if (dadosCompra.data) {
                if (typeof dadosCompra.data === 'string' && dadosCompra.data.includes('/')) {
                    // Caso a data esteja no formato "dd/MM/yyyy"
                    const partes = dadosCompra.data.split('/');
                    if (partes.length === 3) {
                        const dia = partes[0].padStart(2, '0');
                        const mes = partes[1].padStart(2, '0');
                        const ano = partes[2];
                        dataFormatada = `${ano}-${mes}-${dia}`;
                    }
                } else {
                    // Caso a data esteja no formato Date ou ISO (ex.: "2025-06-03")
                    const dateObj = new Date(dadosCompra.data);
                    if (!isNaN(dateObj)) {
                        dataFormatada = dateObj.toISOString().split('T')[0];
                    }
                }
            }

            document.getElementById('editData').value = dataFormatada;

            var modal = new bootstrap.Modal(document.getElementById('modalEditarCompra'));
            modal.show();
        }
    </script>
}
