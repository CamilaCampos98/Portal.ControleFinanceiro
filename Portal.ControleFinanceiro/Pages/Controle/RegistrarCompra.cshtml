@page
@model Portal.ControleFinanceiro.Pages.Controle.RegistrarCompraModel
@{
    ViewData["Title"] = "Registrar Compra";
}
<div class="main-container">
    <div class="page-heading">
        <div>
            <h2><i class="bi bi-cart-plus"></i> Registrar compra</h2>
            <p>Registre uma compra manualmente ou importe os lançamentos de uma fatura.</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.Mensagem))
    {
        <div class="alert @(Model.Sucesso ? "alert-success" : "alert-danger") alert-dismissible fade show shadow-sm mt-3" role="alert">
            <span>@Model.Mensagem</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <section class="data-entry-card" aria-labelledby="compraManualTitulo">
    <h3 id="compraManualTitulo">Compra manual</h3>
    <p class="text-muted">Os campos com * são obrigatórios.</p>
    <form method="post" asp-page-handler="Registrar" id="formCompraManual" novalidate>
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Pessoa <span class="required-mark">*</span></label>
                <input asp-for="Input.Pessoa" class="form-control" placeholder="Ex.: João" required />
                <span asp-validation-for="Input.Pessoa" class="invalid-feedback d-block"></span>
            </div>
            <div class="col-md-4">
                <label class="form-label">Descrição <span class="required-mark">*</span></label>
                <input asp-for="Input.Descricao" class="form-control" placeholder="Ex.: Mercado" required autofocus />
                <span asp-validation-for="Input.Descricao" class="invalid-feedback d-block"></span>
            </div>
            <div class="col-md-4">
                <label class="form-label">Valor (R$) <span class="required-mark">*</span></label>
                <input asp-for="Input.ValorTotal" class="form-control" type="number" min="0.01" step="0.01" required />
                <small id="compraValorFormatado" class="form-text">R$ 0,00</small>
                <span asp-validation-for="Input.ValorTotal" class="invalid-feedback d-block"></span>
            </div>
            <div class="col-md-4">
                <label class="form-label">Data da compra <span class="required-mark">*</span></label>
                <input asp-for="Input.Data" class="form-control" type="date" required />
            </div>
            <div class="col-md-4">
                <label class="form-label">Forma de pagamento <span class="required-mark">*</span></label>
                <select asp-for="Input.FormaPgto" class="form-select">
                    <option value="C">Crédito</option>
                    <option value="D">Débito</option>
                </select>
            </div>
            <div class="col-md-4" id="cartao-div">
                <label class="form-label">Cartão <span class="required-mark">*</span></label>
                <select asp-for="Input.Cartao" class="form-select" id="selectCartao">
                    <option value="">Selecione...</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Parcelas <span class="required-mark">*</span></label>
                <input asp-for="Input.TotalParcelas" class="form-control" type="number" min="1" value="1" required />
            </div>
            <div class="col-md-4">
                <label class="form-label">Fonte <span class="required-mark">*</span></label>
                <input asp-for="Input.Fonte" class="form-control" placeholder="Ex.: Salário" required />
            </div>
        </div>

        <div id="compraManualRevisao" class="purchase-review d-none mt-3" aria-live="polite"></div>
        <div class="form-actions mt-3">
            <button class="btn btn-success" type="button" id="btnRevisarCompra"><i class="bi bi-eye"></i> Revisar compra</button>
            <button class="btn btn-outline-secondary d-none" type="button" id="btnEditarCompra"><i class="bi bi-arrow-left"></i> Corrigir dados</button>
            <button class="btn btn-success d-none" type="submit" id="btnConfirmarCompra"><i class="bi bi-check-circle"></i> Confirmar registro</button>
        </div>
    </form>
    </section>

    <section class="import-entry-card mt-3">
        <div><h3>Importar fatura</h3><p>Cole os lançamentos, confira o período e revise a quantidade antes de importar.</p></div>
        <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#importarModal"><i class="bi bi-upload"></i> Abrir importação</button>
    </section>
</div>
<div class="loading-overlay" id="loadingOverlay">
    <div>
        <div class="spinner-border text-primary" role="status"></div>
    </div>
</div>

<div class="modal fade" id="importarModal" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-fullscreen-sm-down">
        <div class="modal-content">

            <form method="post"
                  enctype="multipart/form-data"
                  asp-page-handler="ImportarFatura">

                <div class="modal-header">
                    <h5 class="modal-title">Importar fatura</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Pessoa</label>
                        <input type="text"
                               name="PessoaImportacao"
                               class="form-control"
                               placeholder="Ex: Camila ou Diego"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Cartão</label>
                        <select name="CartaoImportacao"
                                class="form-select"
                                required>
                            <option value="">Selecione...</option>
                            @* reaproveita os mesmos cartões *@
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Mês da fatura</label>
                        <input type="month"
                               name="MesFatura"
                               class="form-control"
                               required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="entrada">Lançamentos copiados da fatura</label>
                        <textarea id="entrada" class="form-control" rows="8" placeholder="Cole aqui os lançamentos do cartão"></textarea>
                    </div>

                    <div class="import-preview" id="importPreview">
                        <span>Período e parcelas serão conferidos antes do envio.</span>
                    </div>
                    <div id="importComparison" class="import-comparison d-none" aria-live="polite"></div>
                    <div id="importError" class="alert alert-danger d-none mt-3" role="alert"></div>

                    <textarea id="saidaCamila" hidden></textarea>
                    <textarea id="saidaDiego" hidden></textarea>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-primary" id="btnConferirImportacao">
                            <i class="bi bi-search"></i>
                            Conferir fatura
                        </button>
                        <button type="submit" class="btn btn-primary" id="btnImportarAgora" disabled>
                            <i class="bi bi-upload"></i>
                            Importar agora
                        </button>
                    </div>
                    <input type="hidden" name="CsvGerado" id="CsvGerado" />
                </div>
                
            </form>

        </div>
    </div>
</div>


@* <script src="~/js/registrarcompra.js"></script> *@

@section Scripts {
    <script>
         const formaPgto = document.querySelector('[name="Input.FormaPgto"]');
         const cartaoDiv = document.querySelector('#cartao-div');
         const cartaoSelect = document.querySelector('[name="Input.Cartao"]');

         function toggleCartao() {
             if (formaPgto.value === 'C') {
                 cartaoDiv.style.display = 'block';
                 cartaoSelect.setAttribute('required', 'required');
             } else {
                 cartaoDiv.style.display = 'none';
                 cartaoSelect.removeAttribute('required');
                 cartaoSelect.value = '';
             }
         }

         formaPgto.addEventListener('change', toggleCartao);

         // Executa no carregamento inicial
         toggleCartao();

         const formCompraManual = document.getElementById('formCompraManual');
         const btnRevisarCompra = document.getElementById('btnRevisarCompra');
         const btnEditarCompra = document.getElementById('btnEditarCompra');
         const btnConfirmarCompra = document.getElementById('btnConfirmarCompra');
         const compraRevisao = document.getElementById('compraManualRevisao');
         const valorCompra = document.getElementById('Input_ValorTotal');

         formaPgto.addEventListener('change', () => {
             if (btnRevisarCompra) btnRevisarCompra.disabled = formaPgto.value === 'C' && cartaoSelect.disabled;
         });

         valorCompra?.addEventListener('input', () => {
             document.getElementById('compraValorFormatado').textContent = formatarMoeda(Number(valorCompra.value || 0));
         });

         btnRevisarCompra?.addEventListener('click', () => {
             formCompraManual.classList.add('was-validated');
             if (!formCompraManual.checkValidity()) {
                 formCompraManual.querySelector(':invalid')?.focus();
                 return;
             }

             const credito = formaPgto.value === 'C';
             compraRevisao.innerHTML = `<h6>Confira antes de registrar</h6><div>`
                 + `<strong>${escaparHtml(document.getElementById('Input_Descricao').value)}</strong>`
                 + `<span>${formatarMoeda(Number(valorCompra.value))}</span>`
                 + `<span>${formatarDataInput(document.getElementById('Input_Data').value)}</span>`
                 + `<span>${credito ? `Crédito · ${escaparHtml(cartaoSelect.value)} · ${document.getElementById('Input_TotalParcelas').value} parcela(s)` : 'Débito'}</span>`
                 + `<span>Fonte: ${escaparHtml(document.getElementById('Input_Fonte').value)}</span></div>`;
             compraRevisao.classList.remove('d-none');
             btnRevisarCompra.classList.add('d-none');
             btnEditarCompra.classList.remove('d-none');
             btnConfirmarCompra.classList.remove('d-none');
             btnConfirmarCompra.focus();
         });

         btnEditarCompra?.addEventListener('click', () => {
             compraRevisao.classList.add('d-none');
             btnRevisarCompra.classList.remove('d-none');
             btnEditarCompra.classList.add('d-none');
             btnConfirmarCompra.classList.add('d-none');
             document.getElementById('Input_Descricao')?.focus();
         });

         document.addEventListener('DOMContentLoaded', function () {
             const overlay = document.getElementById('loadingOverlay');

             const forms = document.querySelectorAll('form');
             const buttons = document.querySelectorAll('form button[type="submit"]');

             forms.forEach(form => {
                 form.addEventListener('submit', function (event) {
                     if (event.defaultPrevented || (form.id === 'formImportarFatura' && form.dataset.ready !== 'true')) {
                         return;
                     }

                     // Ativa overlay
                     overlay.style.display = 'flex';

                     // Ativa loading nos botões do formulário
                     const btns = form.querySelectorAll('button[type="submit"]');
                     btns.forEach(btn => {
                         btn.classList.add('btn-loading');
                     });
                 });
             });
         });

         document.addEventListener("DOMContentLoaded", async function () {
             const selectCartao = document.getElementById("selectCartao");
             const selectCartaoImportacao = document.querySelector('select[name="CartaoImportacao"]');
             const urlApi = '@Model.UrlApi';

                 try {
             const response = await fetch(`${urlApi}Compra/GetCartoes`);

             if (!response.ok) throw new Error("Erro ao buscar cartões.");

             const cartoes = await response.json();

             cartoes.forEach(cartao => {

                 // select da tela principal
                 if (selectCartao) {
                     const option = document.createElement("option");
                     option.value = cartao;
                     option.text = cartao;
                     selectCartao.appendChild(option);
                 }

                 // select do modal de importação
                 if (selectCartaoImportacao) {
                     const option2 = document.createElement("option");
                     option2.value = cartao;
                     option2.text = cartao;
                     selectCartaoImportacao.appendChild(option2);
                 }

             });

         } catch (error) {
             console.error("Erro ao carregar cartões:", error);
             const aviso = document.createElement('div');
             aviso.className = 'alert alert-warning mt-3';
             aviso.textContent = 'Não foi possível carregar os cartões. Tente novamente antes de registrar uma compra no crédito.';
             document.getElementById('cartao-div')?.appendChild(aviso);
             cartaoSelect.disabled = true;
             if (btnRevisarCompra) btnRevisarCompra.disabled = formaPgto.value === 'C';
         }
         });

        const form = document.querySelector('#importarModal form');
        form.id = 'formImportarFatura';
        const btnConferirImportacao = document.getElementById("btnConferirImportacao");
        const btnImportarAgora = document.getElementById("btnImportarAgora");
        let itensConferenciaAtuais = [];
        let pessoaConferenciaEhDiego = false;

        form.addEventListener("submit", function (e) {
            if (form.dataset.ready !== "true") {
                e.preventDefault();
                prepararImportacao();
            }
        });

        btnConferirImportacao.addEventListener("click", prepararImportacao);

        form.querySelectorAll("input, select, textarea").forEach(campo => {
            campo.addEventListener("input", invalidarConferencia);
            campo.addEventListener("change", invalidarConferencia);
        });

        async function prepararImportacao() {
            const gerouCsv = await gerar(); // agora pode usar await

            if (!gerouCsv)
                return;

            const pessoa =
                document.querySelector('input[name="PessoaImportacao"]').value
                    .trim()
                    .toLowerCase();

            let csv;

            if (pessoa.includes("diego"))
                csv = document.getElementById("saidaDiego").value;
            else
                csv = document.getElementById("saidaCamila").value;

            document.getElementById("CsvGerado").value = csv;
            const possuiLancamentos = csv.split(/\r?\n/).filter(linha => linha.trim()).length > 1;
            form.dataset.ready = possuiLancamentos ? "true" : "false";
            btnImportarAgora.disabled = !possuiLancamentos;
            btnConferirImportacao.innerHTML = possuiLancamentos
                ? '<i class="bi bi-check2-circle"></i> Conferido'
                : '<i class="bi bi-check-all"></i> Tudo já cadastrado';
        }

        function invalidarConferencia() {
            form.dataset.ready = "false";
            btnImportarAgora.disabled = true;
            btnConferirImportacao.innerHTML = '<i class="bi bi-search"></i> Conferir fatura';
            document.getElementById("CsvGerado").value = "";
            document.getElementById("importComparison").classList.add("d-none");
            document.getElementById("importError").classList.add("d-none");
        }


        async function gerar() {

            const texto = document.getElementById("entrada").value;

            const mesFaturaInput = document.querySelector('[name="MesFatura"]').value;
            // formato: yyyy-MM
            if (!mesFaturaInput) {
                mostrarErroImportacao("Selecione o mês da fatura.");
                return false;
            }

            const urlApi = '@Model.UrlApi';

            const pessoa = document.querySelector('[name="PessoaImportacao"]').value;
            const cartao = document.querySelector('[name="CartaoImportacao"]').value;

            if (!pessoa || !cartao || !texto.trim()) {
                mostrarErroImportacao("Informe pessoa, cartão e os lançamentos da fatura.");
                return false;
            }

            const mesAnoTela = mesFaturaInput;

            // converte para MM/yyyy (formato da sua planilha / API)
            const [ano, mes] = mesAnoTela.split("-");
            const mesAno = `${mes}/${ano}`;

            const url =
                `${urlApi}Compra/PeriodoFatura`
                + `?pessoa=${encodeURIComponent(pessoa)}`
                + `&mesAno=${encodeURIComponent(mesAno)}`
                + `&cartao=${encodeURIComponent(cartao)}`;

            const resp = await fetch(url);

            if (!resp.ok) {
                mostrarErroImportacao("Não foi possível obter o período da fatura.");
                return false;
            }

            const periodo = await resp.json();

            const inicioFatura = new Date(periodo.inicio);
            const fimFatura    = new Date(periodo.fim);

            const linhas = texto.split(/\r?\n/);

            const itensCamila = [];
            const itensDiego = [];
            let ultimoItem = null;

            const meses = {
                "jan.": "01",
                "fev.": "02",
                "mar.": "03",
                "abr.": "04",
                "mai.": "05",
                "jun.": "06",
                "jul.": "07",
                "ago.": "08",
                "set.": "09",
                "out.": "10",
                "nov.": "11",
                "dez.": "12"
            };

            for (let i = 0; i < linhas.length; i++) {

                let linha = linhas[i].trim();

                if (!linha)
                    continue;

                const l = linha.toLowerCase();

                const parcelaLinha = extrairParcela(linha);
                if (l.startsWith("parcela") || (parcelaLinha && !l.includes("r$"))) {
                    if (ultimoItem && parcelaLinha) {
                        ultimoItem.parcelaAtual = parcelaLinha.atual;
                        ultimoItem.totalParcelas = parcelaLinha.total;
                    }
                    continue;
                }

                if (l.includes("pagamento efetuado"))
                    continue;

                const match = linha.match(
                    /^(\d{1,2})\s+([a-zç]{3}\.)\s+(.*?)\s+R\$\s*(-?\s?\d{1,3}(?:\.\d{3})*,\d{2}|-?\s?\d+[.,]\d{2})$/i
                );

                if (!match)
                    continue;

                const diaTxt     = match[1];
                const mesTxt     = match[2].toLowerCase();
                const descricao  = match[3].trim();
                const valorTxt   = match[4].trim();

                const mesStr = meses[mesTxt];

                if (!mesStr)
                    continue;

                const dia = diaTxt.padStart(2, "0");
                const mes = parseInt(mesStr, 10);

                // ano base ajustado
                let anoBase = inicioFatura.getFullYear();

                // se o mês da compra for MAIOR que o mês de início da fatura,
                // começa no ano anterior
                if (mes - 1 > inicioFatura.getMonth()) {
                    anoBase--;
                }

                let dataTeste = new Date(
                    anoBase,
                    mes - 1,
                    parseInt(dia, 10)
                );

                // empurra para frente até cair dentro da fatura
                while (dataTeste < inicioFatura || dataTeste > fimFatura) {
                    dataTeste.setMonth(dataTeste.getMonth() + 1);
                }

                const dataIso = dataTeste.toISOString().slice(0, 10);

                const valor = valorTxt
                    .replace(/\s/g, "")
                    .replace(/\./g, "")
                    .replace(",", ".");

                const ehAdicional = descricao.toLowerCase().includes("adicional");
                const parcelaDescricao = extrairParcela(descricao);
                const item = {
                    dataIso,
                    descricao,
                    valor,
                    parcelaAtual: parcelaDescricao?.atual || 1,
                    totalParcelas: parcelaDescricao?.total || 1
                };

                if (ehAdicional) {
                    itensDiego.push(item);
                } else {
                    itensCamila.push(item);
                }

                ultimoItem = item;
            }

            const pessoaEhDiego = pessoa.trim().toLowerCase().includes("diego");
            const itensSelecionados = pessoaEhDiego ? itensDiego : itensCamila;
            const conferencia = await conferirComprasExistentes(urlApi, pessoa, itensSelecionados);
            if (!conferencia) return false;

            itensConferenciaAtuais = conferencia.naoCadastradas;
            pessoaConferenciaEhDiego = pessoaEhDiego;

            const csvCamila = montarCsv(pessoaEhDiego ? itensCamila : conferencia.naoCadastradas);
            const csvDiego = montarCsv(pessoaEhDiego ? conferencia.naoCadastradas : itensDiego);

            document.getElementById("saidaCamila").value = csvCamila;
            document.getElementById("saidaDiego").value  = csvDiego;

            const totalParcelados = itensSelecionados
                .filter(item => item.totalParcelas > 1)
                .length;

            document.getElementById("importPreview").innerHTML =
                `<strong>Período:</strong> ${formatarData(inicioFatura)} até ${formatarData(fimFatura)}<br>` +
                `<strong>Encontradas:</strong> ${itensSelecionados.length} · ` +
                `<strong>Já cadastradas:</strong> ${conferencia.jaCadastradas.length} · ` +
                `<strong>A importar:</strong> ${conferencia.naoCadastradas.length} · ` +
                `<strong>Parcelados:</strong> ${totalParcelados}`;

            renderizarConferencia(conferencia);

            return true;
        }

        async function conferirComprasExistentes(urlApi, pessoa, itens) {
            try {
                const response = await fetch(`${urlApi}Compra/GetCompras?pessoa=${encodeURIComponent(pessoa)}`);
                if (!response.ok) throw new Error('Falha ao buscar compras existentes.');

                const chaves = await response.json();
                const existentes = chaves.map(chave => {
                    const partes = String(chave).split('|');
                    return { dataIso: partes[1], valor: Number(partes[2]), usado: false };
                }).filter(item => item.dataIso && Number.isFinite(item.valor));

                const jaCadastradas = [];
                const naoCadastradas = [];

                itens.forEach(item => {
                    const valorItem = Number(item.valor);
                    const indice = existentes.findIndex(existente =>
                        !existente.usado &&
                        existente.dataIso === item.dataIso &&
                        Math.abs(existente.valor - valorItem) <= 0.0100001);

                    if (indice >= 0) {
                        existentes[indice].usado = true;
                        jaCadastradas.push(item);
                    } else {
                        naoCadastradas.push(item);
                    }
                });

                return { jaCadastradas, naoCadastradas };
            } catch (error) {
                mostrarErroImportacao('Não foi possível conferir as compras já cadastradas. A importação foi bloqueada para evitar duplicidades.');
                return null;
            }
        }

        function renderizarConferencia(conferencia) {
            const container = document.getElementById('importComparison');
            const linhas = conferencia.naoCadastradas.map((item, indice) => `
                <tr><td class="import-selection"><input type="checkbox" class="form-check-input import-item-check" data-index="${indice}" checked aria-label="Importar ${escaparHtml(item.descricao)}"></td><td>${formatarDataInput(item.dataIso)}</td><td>${escaparHtml(item.descricao)}</td><td>${formatarMoeda(Number(item.valor))}</td></tr>`).join('');

            container.innerHTML = `<div class="import-comparison__header"><div><strong>Escolha as compras que serão importadas</strong><span id="importSelectionCount">${conferencia.naoCadastradas.length} de ${conferencia.naoCadastradas.length} selecionada(s)</span></div><span class="status-badge ${conferencia.naoCadastradas.length ? 'status-open' : 'status-paid'}">${conferencia.naoCadastradas.length ? 'Revisar' : 'Tudo cadastrado'}</span></div>`
                + (linhas ? `<div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th class="import-selection"><input type="checkbox" class="form-check-input" id="importSelectAll" checked aria-label="Selecionar ou desmarcar todas"></th><th>Data</th><th>Compra</th><th>Valor</th></tr></thead><tbody>${linhas}</tbody></table></div>` : '<p class="mb-0 text-muted">Nenhuma compra nova para importar.</p>')
                + (conferencia.jaCadastradas.length ? `<details><summary>${conferencia.jaCadastradas.length} compra(s) já cadastrada(s) foram ignoradas</summary><ul>${conferencia.jaCadastradas.map(item => `<li>${formatarDataInput(item.dataIso)} · ${escaparHtml(item.descricao)} · ${formatarMoeda(Number(item.valor))}</li>`).join('')}</ul></details>` : '');
            container.classList.remove('d-none');

            container.querySelectorAll('.import-item-check').forEach(check => check.addEventListener('change', atualizarSelecaoImportacao));
            container.querySelector('#importSelectAll')?.addEventListener('change', event => {
                container.querySelectorAll('.import-item-check').forEach(check => check.checked = event.target.checked);
                atualizarSelecaoImportacao();
            });
        }

        function atualizarSelecaoImportacao() {
            const checks = Array.from(document.querySelectorAll('.import-item-check'));
            const selecionados = checks
                .filter(check => check.checked)
                .map(check => itensConferenciaAtuais[Number(check.dataset.index)])
                .filter(Boolean);
            const csv = montarCsv(selecionados);

            if (pessoaConferenciaEhDiego) document.getElementById('saidaDiego').value = csv;
            else document.getElementById('saidaCamila').value = csv;

            document.getElementById('CsvGerado').value = csv;
            document.getElementById('importSelectionCount').textContent = `${selecionados.length} de ${checks.length} selecionada(s)`;
            form.dataset.ready = selecionados.length ? 'true' : 'false';
            btnImportarAgora.disabled = selecionados.length === 0;
            btnImportarAgora.innerHTML = selecionados.length
                ? `<i class="bi bi-upload"></i> Importar ${selecionados.length} compra(s)`
                : '<i class="bi bi-slash-circle"></i> Nenhuma selecionada';

            const selecionarTodos = document.getElementById('importSelectAll');
            if (selecionarTodos) {
                selecionarTodos.checked = checks.length > 0 && selecionados.length === checks.length;
                selecionarTodos.indeterminate = selecionados.length > 0 && selecionados.length < checks.length;
            }
        }

        function montarCsv(itens) {
            let csv = "data,lançamento,valor,parcelaAtual,totalParcelas\n";

            itens.forEach(item => {
                csv += `${item.dataIso},"${escaparCsv(item.descricao)}",${item.valor},${item.parcelaAtual},${item.totalParcelas}\n`;
            });

            return csv;
        }

        function escaparCsv(valor) {
            return String(valor || "").replace(/"/g, '""');
        }

        function extrairParcela(texto) {
            const normalizado = String(texto || "").toLowerCase();
            let match = normalizado.match(/(?:parcela\s*)?(\d{1,2})\s*\/\s*(\d{1,2})/);

            if (!match) {
                match = normalizado.match(/(?:parcela\s*)?(\d{1,2})\s+de\s+(\d{1,2})/);
            }

            if (!match)
                return null;

            const atual = parseInt(match[1], 10);
            const total = parseInt(match[2], 10);

            if (!Number.isFinite(atual) || !Number.isFinite(total) || total <= 1)
                return null;

            return {
                atual: Math.max(1, Math.min(atual, total)),
                total
            };
        }

        function formatarData(data) {
            return data.toLocaleDateString("pt-BR", { timeZone: "UTC" });
        }

        function mostrarErroImportacao(mensagem) {
            const erro = document.getElementById('importError');
            erro.textContent = mensagem;
            erro.classList.remove('d-none');
        }

        function escaparHtml(valor) {
            const elemento = document.createElement('div');
            elemento.textContent = valor || '';
            return elemento.innerHTML;
        }

        function formatarMoeda(valor) {
            return Number(valor || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
        }

        function formatarDataInput(valor) {
            if (!valor) return '';
            const [ano, mes, dia] = valor.split('-');
            return `${dia}/${mes}/${ano}`;
        }

    </script>
}
