@page
@model Portal.ControleFinanceiro.Pages.Controle.RegistrarEntradaModel
@{
    ViewData["Title"] = "Registrar Entrada";
    Layout = "_HomeLayout";
}

<main class="income-entry-page">
<header class="income-entry-heading">
    <div><span class="eyebrow">Receitas</span><h1>Registrar entrada</h1><p>Cadastre o salário mensal ou acrescente horas extras ao período.</p></div>
    <span class="income-entry-heading-icon" aria-hidden="true"><i class="bi bi-wallet2"></i></span>
</header>

@if (!string.IsNullOrEmpty(Model.Mensagem))
{
    <div class="alert @(Model.Sucesso ? "alert-success" : "alert-danger") alert-dismissible fade show shadow-sm mb-0" role="alert">
        <span class="message-preserve-lines">@Model.Mensagem</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="income-entry-layout">
    <section class="income-form-card" aria-labelledby="dadosEntradaTitulo">
        <div class="income-section-heading">
            <span class="income-section-icon" aria-hidden="true"><i class="bi bi-pencil-square"></i></span>
            <div><h2 id="dadosEntradaTitulo">Dados da entrada</h2><p>Escolha o tipo e confira a estimativa antes de registrar.</p></div>
        </div>
        <form method="post" id="formEntrada" novalidate>
            <div class="row g-3 income-fields">
                <div class="col-md-6">
                    <label class="form-label">Tipo de entrada <span class="required-mark">*</span></label>
                    <select asp-for="Input.TipoEntrada" class="form-select" onchange="atualizarCamposEntrada()"><option value="Salario">Salário</option><option value="Extra">Hora extra</option></select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Pessoa <span class="required-mark">*</span></label>
                    <input asp-for="Input.Pessoa" class="form-control" placeholder="Ex.: Camila ou Diego" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Mês/Ano do Resumo <span class="required-mark">*</span></label>
                    <input asp-for="Input.MesAno" id="filtroPeriodo" class="form-control" placeholder="Ex.: 05/2026" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Valor da hora <span class="required-mark salary-required">*</span></label>
                    <div class="income-money-field"><span>R$</span><input asp-for="Input.ValorHora" class="form-control" type="text" inputmode="decimal" placeholder="0,00" /></div>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Horas úteis no mês <span class="required-mark salary-required">*</span></label>
                    <input asp-for="Input.HorasUteisMes" class="form-control" type="number" placeholder="Calculado automaticamente" />
                    <small id="horasUteisStatus" class="form-text" aria-live="polite">Preenchido automaticamente conforme o período.</small>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Horas extras <span class="required-mark extra-required d-none">*</span></label>
                    <input asp-for="Input.HorasExtras" class="form-control" type="text" inputmode="decimal" placeholder="Ex.: 8,5" />
                </div>
            </div>

            <div class="entry-preview mt-4" id="entradaPreview" role="status" aria-live="polite"><span>Preencha os dados para visualizar o cálculo.</span></div>
            <div class="income-form-actions mt-4"><button class="btn btn-success" type="submit"><i class="bi bi-check-circle"></i> Registrar entrada</button></div>
        </form>
    </section>

    <aside class="income-info-card" role="note">
        <span class="income-info-icon" aria-hidden="true"><i class="bi bi-calendar-range"></i></span>
        <span class="eyebrow">Entenda o período</span>
        <h2>Período financeiro</h2>
        <p>Informe o mesmo Mês/Ano usado no Resumo. Uma entrada em <strong>08/2026</strong> compõe o Resumo 08/2026.</p>
        <div class="income-period-example"><span>Folha considerada</span><strong>26/07 a 25/08</strong><small>Recebida em setembro</small></div>
        <p class="income-info-footnote"><i class="bi bi-stars" aria-hidden="true"></i> As horas úteis são consultadas automaticamente.</p>
    </aside>
</div>

<section class="income-form-card income-salaries-card" aria-labelledby="salariosCadastradosTitulo">
    <div class="income-section-heading income-salaries-heading">
        <span class="income-section-icon" aria-hidden="true"><i class="bi bi-table"></i></span>
        <div><h2 id="salariosCadastradosTitulo">Salários cadastrados</h2><p>Período atual e próximos 6 meses · extras separados.</p></div>
        <button class="btn btn-outline-success income-next-salaries-button" id="prepararProximosSalarios" type="button" @(Model.SalariosCadastrados.Count == 0 ? "disabled" : null)>
            <i class="bi bi-calendar-plus" aria-hidden="true"></i> Próximos 6 meses
        </button>
    </div>
    <div class="income-salary-plan" id="proximosSalariosPainel" hidden>
        <p class="income-salary-plan-summary" id="proximosSalariosResumo"></p>
        <p class="income-salary-plan-note">Os fixos mais recentes dessa pessoa serão copiados para cada mês novo, com novo vencimento e como “Não pago”.</p>
        <label class="income-salary-plan-check"><input type="checkbox" id="usarNovoValorHora" /> Informar novo valor-hora</label>
        <div class="income-salary-plan-rate" id="novoValorHoraArea" hidden>
            <label for="novoValorHora">Novo valor por hora (R$)</label>
            <input class="form-control" id="novoValorHora" type="text" inputmode="decimal" placeholder="Ex.: 60,00" />
        </div>
        <p class="income-salary-plan-status" id="proximosSalariosStatus" role="status" aria-live="polite"></p>
        <div class="income-salaries-list">
            <table class="income-salaries-table">
                <thead><tr><th scope="col">Período</th><th scope="col">Horas úteis</th><th scope="col">Salário</th></tr></thead>
                <tbody id="proximosSalariosLinhas"></tbody>
            </table>
        </div>
        <form method="post" asp-page-handler="RegistrarProximosSalarios" id="formProximosSalarios" class="income-salary-plan-actions">
            <input type="hidden" name="planoJson" id="proximosSalariosJson" />
            <button class="btn btn-success" type="submit" id="confirmarProximosSalarios" disabled>Registrar salários e fixos</button>
        </form>
    </div>
    @if (!string.IsNullOrEmpty(Model.AvisoSalarios))
    {
        <p class="income-salaries-message" role="status">@Model.AvisoSalarios</p>
    }
    else if (Model.SalariosNoPeriodo.Count == 0)
    {
        <p class="income-salaries-message">Nenhum salário cadastrado nesse intervalo.</p>
    }
    else
    {
        <div class="income-salaries-list">
            <table class="income-salaries-table income-salaries-history-table">
                <thead><tr><th scope="col">Período</th><th scope="col">Pessoa</th><th scope="col">Salário</th><th scope="col">Extras</th></tr></thead>
                <tbody>
                    @foreach (var salario in Model.SalariosNoPeriodo)
                    {
                        <tr>
                            <td data-label="Período">@salario.MesAno</td>
                            <td data-label="Pessoa">@salario.Pessoa</td>
                            <td data-label="Salário">@salario.Valor.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</td>
                            <td data-label="Extras">@salario.Extras.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
<script type="application/json" id="salariosCadastradosJson">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SalariosCadastrados))</script>
</main>
<div class="loading-overlay" id="loadingOverlay">
    <div>
        <div class="spinner-border text-primary" role="status"></div>
    </div>
</div>

@* <script src="~/js/registrarentrada.js"></script>*@
<script src="https://unpkg.com/imask"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

 @section Scripts {
    <script>
         window.onload = function () {
            var elemento = document.getElementById('filtroPeriodo');
            if (elemento) {
                IMask(elemento, {
                    mask: '00/0000',
                    placeholderChar: '_',
                });
            }
        }
         // Executa na primeira carga para ajustar os campos
        document.addEventListener("DOMContentLoaded", function () {
            atualizarCamposEntrada();
        });

        const salariosCadastrados = JSON.parse(document.getElementById('salariosCadastradosJson').textContent);
        let planoProximosSalarios = null;
        const moedaBrasileira = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' });

        function formatarPeriodo(data) {
            return `${String(data.getMonth() + 1).padStart(2, '0')}/${data.getFullYear()}`;
        }

        function lerNovoValorHora() {
            const texto = document.getElementById('novoValorHora').value.trim().replace(/\s/g, '');
            if (!texto) return 0;
            const normalizado = texto.includes(',') ? texto.replace(/\./g, '').replace(',', '.') : texto;
            const valor = Number(normalizado);
            return Number.isFinite(valor) && valor > 0 ? valor : 0;
        }

        function atualizarPreviaProximosSalarios() {
            if (!planoProximosSalarios) return;
            const usarNovoValor = document.getElementById('usarNovoValorHora').checked;
            document.getElementById('novoValorHoraArea').hidden = !usarNovoValor;
            const novoValor = usarNovoValor ? lerNovoValorHora() : null;
            const valorHora = novoValor ?? planoProximosSalarios.UltimoValorHora;
            const valido = valorHora > 0;
            const corpo = document.getElementById('proximosSalariosLinhas');
            corpo.replaceChildren();
            for (const mes of planoProximosSalarios.Meses) {
                const linha = document.createElement('tr');
                for (const texto of [mes.MesAno, `${mes.HorasUteis} h`, valido ? moedaBrasileira.format(mes.HorasUteis * valorHora) : '—']) {
                    const celula = document.createElement('td');
                    celula.textContent = texto;
                    linha.appendChild(celula);
                }
                corpo.appendChild(linha);
            }
            document.getElementById('proximosSalariosStatus').textContent = valido
                ? `Valor-hora usado: ${moedaBrasileira.format(valorHora)}. Confira salários e fixos antes de registrar.`
                : 'Informe um novo valor-hora maior que zero.';
            document.getElementById('confirmarProximosSalarios').disabled = !valido;
            document.getElementById('proximosSalariosJson').value = valido
                ? JSON.stringify({ ...planoProximosSalarios, NovoValorHora: novoValor })
                : '';
        }

        async function prepararProximosSalarios() {
            planoProximosSalarios = null;
            const painel = document.getElementById('proximosSalariosPainel');
            const status = document.getElementById('proximosSalariosStatus');
            const botao = document.getElementById('prepararProximosSalarios');
            painel.hidden = false;
            document.getElementById('proximosSalariosResumo').textContent = '';
            document.getElementById('proximosSalariosLinhas').replaceChildren();
            document.getElementById('confirmarProximosSalarios').disabled = true;
            document.getElementById('proximosSalariosJson').value = '';

            const pessoa = document.getElementById('Input_Pessoa').value.trim();
            const ultimo = salariosCadastrados.find(salario => salario.Pessoa.toLocaleLowerCase('pt-BR') === pessoa.toLocaleLowerCase('pt-BR'));
            if (!ultimo || ultimo.ValorHora <= 0) {
                status.textContent = 'Selecione uma pessoa que já tenha salário e valor-hora cadastrados.';
                return;
            }

            botao.disabled = true;
            status.textContent = 'Calculando os seis períodos e feriados…';
            try {
                const [mes, ano] = ultimo.MesAno.split('/').map(Number);
                const meses = await Promise.all(Array.from({ length: 6 }, async (_, indice) => {
                    const data = new Date(ano, mes + indice, 1);
                    const folha = new Date(data.getFullYear(), data.getMonth() - 1, 1);
                    const url = `@Url.Page("/Controle/CalculadoraHorasUteis")?handler=CalcularPeriodo&mesAno=${encodeURIComponent(formatarPeriodo(folha))}`;
                    const resposta = await fetch(url);
                    if (!resposta.ok) throw new Error('Não foi possível calcular as horas úteis.');
                    const calculo = await resposta.json();
                    if (calculo.avisoFeriados || !calculo.totalHorasUteis)
                        throw new Error('A consulta de feriados falhou. Tente novamente antes de registrar.');
                    return { MesAno: formatarPeriodo(data), HorasUteis: calculo.totalHorasUteis };
                }));

                if (document.getElementById('Input_Pessoa').value.trim().toLocaleLowerCase('pt-BR') !== pessoa.toLocaleLowerCase('pt-BR'))
                    return;

                planoProximosSalarios = {
                    Pessoa: ultimo.Pessoa,
                    UltimoMesAno: ultimo.MesAno,
                    UltimoValorHora: ultimo.ValorHora,
                    Meses: meses
                };
                document.getElementById('proximosSalariosResumo').textContent =
                    `${ultimo.Pessoa}: após ${ultimo.MesAno}, de ${meses[0].MesAno} a ${meses[5].MesAno}.`;
                document.getElementById('usarNovoValorHora').checked = false;
                document.getElementById('novoValorHora').value = '';
                atualizarPreviaProximosSalarios();
            } catch (erro) {
                status.textContent = erro.message || 'Não foi possível preparar os salários.';
            } finally {
                botao.disabled = false;
            }
        }

        document.getElementById('prepararProximosSalarios').addEventListener('click', prepararProximosSalarios);
        document.getElementById('usarNovoValorHora').addEventListener('change', atualizarPreviaProximosSalarios);
        document.getElementById('novoValorHora').addEventListener('input', atualizarPreviaProximosSalarios);
        document.getElementById('Input_Pessoa').addEventListener('input', () => {
            planoProximosSalarios = null;
            document.getElementById('proximosSalariosPainel').hidden = true;
        });

        function atualizarCamposEntrada() {
            const tipo = document.getElementById('Input_TipoEntrada').value;
            const horasExtras = document.getElementById('Input_HorasExtras');
            const horasUteis = document.getElementById('Input_HorasUteisMes');
            const valorHora = document.getElementById('Input_ValorHora');
            const salaryRequired = document.querySelectorAll('.salary-required');
            const extraRequired = document.querySelectorAll('.extra-required');

            if (tipo === 'Extra') {
                horasExtras.disabled = false;
                horasExtras.required = true;
                horasUteis.disabled = true;
                valorHora.disabled = true;
                horasUteis.required = false;
                valorHora.required = false;
                horasUteis.value = '';
                valorHora.value = '';
                salaryRequired.forEach(item => item.classList.add('d-none'));
                extraRequired.forEach(item => item.classList.remove('d-none'));
            } else {
                horasExtras.disabled = true;
                horasExtras.required = false;
                horasExtras.value = '';
                horasUteis.disabled = false;
                valorHora.disabled = false;
                horasUteis.required = true;
                valorHora.required = true;
                salaryRequired.forEach(item => item.classList.remove('d-none'));
                extraRequired.forEach(item => item.classList.add('d-none'));
            }
            atualizarPreviaEntrada();
            if (tipo !== 'Extra') carregarHorasUteis();
        }

        let consultaHorasUteisId = 0;

        async function carregarHorasUteis() {
            const tipo = document.getElementById('Input_TipoEntrada')?.value;
            const periodo = document.getElementById('filtroPeriodo')?.value;
            const campoHoras = document.getElementById('Input_HorasUteisMes');
            const status = document.getElementById('horasUteisStatus');
            if (tipo !== 'Salario' || !/^\d{2}\/\d{4}$/.test(periodo || '')) return;

            const consultaAtual = ++consultaHorasUteisId;
            campoHoras.readOnly = true;
            status.textContent = 'Consultando dias úteis e feriados do período…';

            try {
                const [mes, ano] = periodo.split('/').map(Number);
                const inicioFolha = new Date(ano, mes - 2, 1);
                const periodoFolha = `${String(inicioFolha.getMonth() + 1).padStart(2, '0')}/${inicioFolha.getFullYear()}`;
                const url = `@Url.Page("/Controle/CalculadoraHorasUteis")?handler=CalcularPeriodo&mesAno=${encodeURIComponent(periodoFolha)}`;
                const response = await fetch(url);
                if (!response.ok) throw new Error('Falha na consulta.');
                const resultado = await response.json();
                if (consultaAtual !== consultaHorasUteisId) return;

                campoHoras.value = resultado.totalHorasUteis;
                status.textContent = `${resultado.diasUteis} dias úteis · ${resultado.periodo} · base de ${resultado.horasPorDia} h/dia.`;
                atualizarPreviaEntrada();
            } catch (error) {
                if (consultaAtual !== consultaHorasUteisId) return;
                status.textContent = 'Não foi possível calcular automaticamente. Informe as horas manualmente.';
            } finally {
                if (consultaAtual === consultaHorasUteisId) campoHoras.readOnly = false;
            }
        }

        document.querySelectorAll('#formEntrada input, #formEntrada select').forEach(campo => {
            campo.addEventListener('input', atualizarPreviaEntrada);
            campo.addEventListener('change', atualizarPreviaEntrada);
        });

        document.getElementById('filtroPeriodo')?.addEventListener('change', carregarHorasUteis);
        document.getElementById('filtroPeriodo')?.addEventListener('blur', carregarHorasUteis);

        function atualizarPreviaEntrada() {
            const tipo = document.getElementById('Input_TipoEntrada')?.value;
            const preview = document.getElementById('entradaPreview');
            if (!preview) return;

            if (tipo === 'Extra') {
                const horas = parseNumero(document.getElementById('Input_HorasExtras')?.value);
                preview.innerHTML = horas > 0
                    ? `<strong>${horas.toLocaleString('pt-BR')} hora(s) extra(s)</strong><span>O valor será calculado usando a base salarial cadastrada.</span>`
                    : '<span>Informe as horas extras para conferir o lançamento.</span>';
                return;
            }

            const valorHora = parseNumero(document.getElementById('Input_ValorHora')?.value);
            const horasUteis = parseNumero(document.getElementById('Input_HorasUteisMes')?.value);
            const total = valorHora * horasUteis;
            preview.innerHTML = total > 0
                ? `<span>Salário estimado no período</span><strong>${total.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' })}</strong>`
                : '<span>Preencha valor da hora e horas úteis para visualizar a estimativa.</span>';
        }

        function parseNumero(valor) {
            const numero = Number(String(valor || '0').replace(/\./g, '').replace(',', '.'));
            return Number.isFinite(numero) ? numero : 0;
        }

        document.addEventListener('DOMContentLoaded', function () {
            const overlay = document.getElementById('loadingOverlay');

            const forms = document.querySelectorAll('form');
            const buttons = document.querySelectorAll('form button[type="submit"]');

            forms.forEach(form => {
                form.addEventListener('submit', function (event) {
                    form.classList.add('was-validated');
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        form.querySelector(':invalid')?.focus();
                        return;
                    }
                    // Ativa overlay
                    overlay.style.display = 'flex';

                    // Ativa loading nos botões do formulário
                    const btns = form.querySelectorAll('button[type="submit"]');
                    btns.forEach(btn => {
                        btn.classList.add('btn-loading');
                    });
                });
            });
        });
    </script>
}
