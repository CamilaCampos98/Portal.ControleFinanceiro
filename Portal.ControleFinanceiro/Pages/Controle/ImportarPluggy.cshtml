@page
@model Portal.ControleFinanceiro.Pages.Controle.ImportarPluggyModel
@using System.Globalization
@{
    ViewData["Title"] = "Conferir fatura do Itaú";
    Layout = "_HomeLayout";
    var br = CultureInfo.GetCultureInfo("pt-BR");
}
<main class="container py-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div><span class="text-success text-uppercase small fw-bold">Open Finance</span><h1 class="h3 mb-1">Conferir fatura do Itaú</h1><p class="text-muted mb-0">LATAM Pass Visa Infinite. Nada será cadastrado até você selecionar e confirmar.</p></div>
        <a class="btn btn-outline-secondary" asp-page="/Controle/RegistrarCompra">Voltar às compras</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Aviso)) { <div class="alert alert-success" role="status">@Model.Aviso</div> }
    @if (!string.IsNullOrWhiteSpace(Model.Erro)) { <div class="alert alert-danger" role="alert">@Model.Erro</div> }
    @if (!Model.Configurado)
    {
        <div class="alert alert-info">A conexão com a Pluggy ainda precisa ser configurada no servidor. Nenhuma compra foi alterada.</div>
    }
    else
    {
        <form method="get" class="card card-body mb-4">
            <label class="form-label" for="mes">Mês da fatura</label>
            <div class="d-flex gap-2"><input id="mes" name="Mes" type="month" class="form-control" style="max-width:220px" value="@Model.Mes" required /><button class="btn btn-outline-primary" type="submit">Buscar compras</button></div>
        </form>

        @if (Model.Compras.Count == 0)
        {
            <div class="card card-body">Nenhuma compra foi encontrada para esse mês. Se a fatura ainda estiver aberta, algumas compras podem aparecer após a próxima sincronização da Pluggy.</div>
        }
        else if (Model.ConferenciaDisponivel && Model.ComprasVisiveis.Count == 0)
        {
            <div class="card card-body">Nenhuma compra pendente de conferência neste mês.</div>
        }
        else
        {
            <form method="post" class="card">
                <input type="hidden" asp-for="Mes" />
                <div class="card-body border-bottom">
                    <h2 class="h5">Revise antes de importar</h2>
                    <p class="text-muted small mb-0">Cartões finais 8930 e 6235: Camila, Itaú Titular. Finais 5169 e 3008: Diego, Itaú Adicional. Fonte fixa: Salário. A data de cada parcela segue a data da compra original; o fechamento do cartão determina a fatura. Sem data original, convertemos a data UTC da Pluggy para Brasília. Compras parceladas terão as restantes projetadas. Compras sem um desses finais não podem ser importadas. A conferência exata usa data, valor, pessoa e cartão; quando há um dia de diferença, só reconhece um lançamento único com mesmo valor, pessoa, cartão, parcela e estabelecimento. Em caso de dúvida, a data da planilha prevalece.</p>
                    @if (Model.ConferenciaDisponivel)
                    {
                        <div class="d-flex flex-wrap gap-2 mt-3" role="status">
                            <span class="badge bg-warning text-dark">Revisar: @Model.Conferencia.Values.Count(item => item.Status is "Revisar" or "CartaoDivergente")</span>
                            <span class="badge bg-success">Sem correspondente: @Model.Conferencia.Values.Count(item => item.Status == "NaoEncontrada")</span>
                        </div>
                        <p class="text-muted small mt-2 mb-0">“Revisar” indica mais de uma possível correspondência ou cartão divergente. Só as compras sem correspondente podem ser selecionadas.</p>
                    }
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead><tr><th scope="col">Importar</th><th scope="col">Data da parcela</th><th scope="col">Compra</th><th scope="col">Cartão físico</th><th scope="col">Pessoa</th><th scope="col" class="text-end">Parcela</th><th scope="col" class="text-end">Valor</th><th scope="col">Conferência</th></tr></thead>
                        <tbody>
                        @foreach (var compra in Model.ComprasVisiveis)
                        {
                            Model.Conferencia.TryGetValue(compra.Id, out var resultado);
                            var status = resultado?.Status ?? "Indisponivel";
                            <tr>
                                <td><input class="form-check-input" type="checkbox" name="Selecionados" value="@compra.Id" aria-label="Importar @compra.Description" disabled="@(status != "NaoEncontrada")" /></td>
                                <td class="text-nowrap">
                                    @compra.InstallmentDate.ToString("dd/MM/yyyy", br)
                                    @if (compra.PurchaseDate.HasValue && compra.InstallmentDate != compra.Date)
                                    {
                                        <small class="d-block text-muted">Compra original: @compra.PurchaseDate.Value.ToString("dd/MM/yyyy", br)</small>
                                        <small class="d-block text-muted">Pluggy: @compra.Date.ToString("dd/MM/yyyy", br)</small>
                                    }
                                    else if (!compra.PurchaseDate.HasValue)
                                    {
                                        @if (compra.ReportedDate.HasValue)
                                        {
                                            <small class="d-block text-muted">Pluggy em UTC: @compra.ReportedDate.Value.ToString("dd/MM/yyyy", br) · ajustada para Brasília</small>
                                        }
                                        else
                                        {
                                            <small class="d-block text-muted">Data informada pela Pluggy</small>
                                        }
                                    }
                                </td>
                                <td>@compra.Description@if (string.IsNullOrEmpty(compra.BillMonth)) { <small class="d-block text-warning">Fatura não identificada pela Pluggy; confira o período.</small> }</td>
                                <td>
                                    @(string.IsNullOrWhiteSpace(compra.CardNumber) ? "Não informado" : "Final " + compra.CardNumber[^Math.Min(4, compra.CardNumber.Length)..])
                                    @if (!string.IsNullOrWhiteSpace(compra.ReportedCardNumber))
                                    {
                                        <small class="d-block text-warning">Corrigido: Pluggy informou final @compra.ReportedCardNumber[^Math.Min(4, compra.ReportedCardNumber.Length)..]</small>
                                    }
                                </td>
                                <td>@(compra.Person == "" ? "Não identificada" : compra.Person)</td>
                                <td class="text-end text-nowrap">@compra.InstallmentNumber/@compra.TotalInstallments</td>
                                <td class="text-end text-nowrap fw-bold">@compra.Amount.ToString("C", br)</td>
                                <td>
                                    @if (status == "NaoEncontrada") { <span class="badge bg-success">Sem correspondente</span> }
                                    else if (status is "Revisar" or "CartaoDivergente")
                                    {
                                        <span class="badge bg-warning text-dark">Revisar @(status == "CartaoDivergente" ? "cartão" : "data")</span>
                                        @if (resultado?.Correspondente is { } candidato)
                                        {
                                            <small class="d-block text-muted">Planilha, linha @candidato.Linha: @candidato.Data.ToString("dd/MM/yyyy", br), @candidato.Valor.ToString("C", br), @candidato.Pessoa, @candidato.Cartao — @candidato.Descricao</small>
                                        }
                                    }
                                    else { <span class="badge bg-secondary">Conferência indisponível</span> }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                <div class="card-body border-top d-flex justify-content-end"><button class="btn btn-success" type="submit" disabled="@(!Model.Conferencia.Values.Any(item => item.Status == "NaoEncontrada"))">Confirmar compras selecionadas</button></div>
            </form>
        }
    }
</main>
