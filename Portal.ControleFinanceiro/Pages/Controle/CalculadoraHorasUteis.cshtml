@page
@model CalculadoraHorasUteisModel
@{
    ViewData["Title"] = "Calculadora de Horas Úteis";
}

<div class="main-container workdays-page">
    <div class="page-heading">
        <div>
            <h2>
                <i class="bi bi-calculator"></i>
                Calculadora de Horas Úteis
            </h2>
            <p>Confira dias e horas úteis da folha, considerando fins de semana e feriados de Barueri/SP.</p>
        </div>
        <span class="status-badge status-open">Barueri/SP</span>
    </div>

    <form method="post" class="fixed-control-panel workdays-form" id="formHorasUteis" novalidate>
        <div class="workdays-form-grid">
            <div>
                <label class="form-label" asp-for="Input.MesReferencia">Mês de referência <span class="required-mark">*</span></label>
                <input asp-for="Input.MesReferencia" class="form-control" type="month" required />
                <span asp-validation-for="Input.MesReferencia" class="text-danger small"></span>
            </div>
            <div>
                <label class="form-label" asp-for="Input.HorasPorDia">Horas por dia <span class="required-mark">*</span></label>
                <input asp-for="Input.HorasPorDia" class="form-control" type="number" min="1" max="24" step="1" required />
                <div class="workdays-hour-presets" aria-label="Atalhos de jornada"><button type="button" data-hours="6">6 h</button><button type="button" data-hours="8">8 h</button></div>
                <span asp-validation-for="Input.HorasPorDia" class="text-danger small"></span>
            </div>
            <div class="workdays-actions">
                <button type="submit" class="btn btn-success responsive-button">
                    <i class="bi bi-check2-circle"></i>
                    Calcular
                </button>
            </div>
        </div>
        <div class="period-preview" id="workdaysPeriodPreview" role="status" aria-live="polite"><i class="bi bi-calendar-range" aria-hidden="true"></i><span>Selecione o mês para conferir o período da folha.</span></div>
        <div asp-validation-summary="ModelOnly" class="text-danger mt-3"></div>
    </form>

    @if (Model.Resultado is not null)
    {
        <section class="workdays-result-shell">
            @if (!string.IsNullOrWhiteSpace(Model.AvisoFeriados))
            {
                <div class="import-preview mb-3">
                    <strong>Atenção:</strong> @Model.AvisoFeriados
                </div>
            }

            <div class="workdays-period">
                <div><span class="metric-label">Período calculado</span><strong>@Model.Resultado.Periodo</strong></div>
                <button type="button" class="btn btn-outline-secondary btn-sm" id="copiarHorasUteis" data-texto="@Model.Resultado.TotalHorasUteis horas úteis em @Model.Resultado.DiasUteis dias úteis — período @Model.Resultado.Periodo"><i class="bi bi-clipboard"></i> Copiar resultado</button>
            </div>

            <div class="workdays-summary-grid">
                <div class="metric-card metric-good">
                    <small>Dias úteis</small>
                    <strong>@Model.Resultado.DiasUteis</strong>
                    <span>@Model.Resultado.HorasPorDia h por dia</span>
                </div>
                <div class="metric-card">
                    <small>Total de horas</small>
                    <strong>@Model.Resultado.TotalHorasUteis h</strong>
                    <span>Base para conferência mensal</span>
                </div>
                <div class="metric-card">
                    <small>Dias corridos</small>
                    <strong>@Model.Resultado.DiasTotais</strong>
                    <span>@Model.Resultado.DiasFimSemana em fins de semana</span>
                </div>
                <div class="metric-card metric-warn">
                    <small>Feriados</small>
                    <strong>@Model.Resultado.Feriados.Count</strong>
                    <span>@Model.Resultado.FeriadosEmDiasUteis em dias de semana</span>
                </div>
            </div>

            <div class="workdays-holidays">
                <div class="fixed-table-header">
                    <div>
                        <h4>
                            <i class="bi bi-calendar-event"></i>
                            Feriados considerados
                        </h4>
                        <p>Nacionais, SP, Barueri e principais feriados móveis.</p>
                    </div>
                </div>

                @if (Model.Resultado.Feriados.Count == 0)
                {
                    <div class="holiday-empty">Nenhum feriado no período.</div>
                }
                else
                {
                    <div class="holiday-list">
                        @foreach (var feriado in Model.Resultado.Feriados)
                        {
                            <div class="holiday-item">
                                <div class="holiday-date">
                                    <strong>@feriado.Data.ToString("dd")</strong>
                                    <span>@feriado.Data.ToString("MMM")</span>
                                </div>
                                <div>
                                    <strong>@feriado.Nome</strong>
                                    <span>@feriado.Data.ToString("dddd, dd/MM/yyyy")</span>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </section>
    }
</div>

<div class="loading-overlay" id="loadingOverlay"><div><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Calculando...</span></div></div></div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const form = document.getElementById('formHorasUteis');
            const mes = document.getElementById('Input_MesReferencia');
            const horas = document.getElementById('Input_HorasPorDia');
            const preview = document.getElementById('workdaysPeriodPreview');

            function atualizarPeriodo() {
                if (!mes?.value) return;
                const [ano, numeroMes] = mes.value.split('-').map(Number);
                const inicio = new Date(ano, numeroMes - 1, 26);
                const fim = new Date(ano, numeroMes, 25);
                preview.querySelector('span').textContent = `Folha de ${inicio.toLocaleDateString('pt-BR')} até ${fim.toLocaleDateString('pt-BR')}.`;
            }

            mes?.addEventListener('change', atualizarPeriodo);
            atualizarPeriodo();

            document.querySelectorAll('[data-hours]').forEach(botao => botao.addEventListener('click', () => {
                horas.value = botao.dataset.hours;
                document.querySelectorAll('[data-hours]').forEach(item => item.classList.toggle('active', item === botao));
                horas.focus();
            }));

            form?.addEventListener('submit', event => {
                form.classList.add('was-validated');
                if (!form.checkValidity()) {
                    event.preventDefault();
                    form.querySelector(':invalid')?.focus();
                    return;
                }
                document.getElementById('loadingOverlay').style.display = 'flex';
                form.querySelector('button[type="submit"]').disabled = true;
            });

            document.getElementById('copiarHorasUteis')?.addEventListener('click', async event => {
                const botao = event.currentTarget;
                await navigator.clipboard.writeText(botao.dataset.texto);
                botao.innerHTML = '<i class="bi bi-check2"></i> Copiado';
            });
        });
    </script>
}
