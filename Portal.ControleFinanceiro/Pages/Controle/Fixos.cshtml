@page
@using System.Globalization
@using Portal.ControleFinanceiro.Models
@model Fixos
@{
    ViewData["Title"] = "Gastos Fixos";

    var cultura = new CultureInfo("pt-BR");
    var totalFixos = Model.FixosModel?.Sum(f => ValorFixo(f.Valor)) ?? 0;
    var totalPago = Model.FixosModel?.Where(f => FixoPago(f.Pago)).Sum(f => ValorFixo(f.Valor)) ?? 0;
    var totalPendente = totalFixos - totalPago;
    var quantidadeFixos = Model.FixosModel?.Count ?? 0;
    var quantidadePagos = Model.FixosModel?.Count(f => FixoPago(f.Pago)) ?? 0;
    var quantidadeDivididos = Model.FixosModel?.Count(f => FixoDividido(f.Dividido)) ?? 0;
    var financiamentos = Model.FixosModel?.Where(EhFinanciamento).ToList() ?? new();
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/choices.js/public/assets/styles/choices.min.css" />

<div class="main-container fixed-expenses-page">
    <div class="page-heading">
        <div>
            <h2><i class="bi bi-calendar-check"></i> Gastos Fixos</h2>
            <p>Monte, confira e acompanhe os compromissos recorrentes do mês.</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.Mensagem))
    {
        <div class="alert @(Model.Sucesso ? "alert-success" : "alert-danger") alert-dismissible fade show shadow-sm mt-3" role="alert">
            <pre class="m-0">@Model.Mensagem</pre>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form method="post" class="fixed-control-panel">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label for="Pessoa" class="form-label">Pessoa</label>
                <input asp-for="Pessoa" id="Pessoa" class="form-control" autocomplete="name" />
            </div>
            <div class="col-md-3">
                <label class="form-label" for="Periodo">Período</label>
                <input asp-for="Periodo" id="Periodo" placeholder="Ex.: 05/2026" class="form-control" />
            </div>
            <div class="col-md-6">
                <label for="TiposSelecionados" class="form-label">Tipos de gastos fixos</label>
                <select asp-for="TiposSelecionados" id="TiposSelecionados" class="form-select" multiple size="5" data-placeholder="Carregando tipos..."></select>
                <div class="fixed-selection-tools">
                    <span class="form-text" id="tiposFixosStatus" aria-live="polite">Carregando tipos de gastos...</span>
                    <div><button type="button" class="btn btn-link btn-sm" id="selecionarTodosTipos">Selecionar todos</button><button type="button" class="btn btn-link btn-sm" id="limparTipos">Limpar</button></div>
                </div>
            </div>
        </div>

        <div class="fixed-actions">
            <button type="submit" asp-page-handler="Listar" class="btn btn-success">
                <i class="bi bi-list"></i>
                Listar fixos
            </button>
            <button type="submit" asp-page-handler="Gerar" class="btn btn-outline-success">
                <i class="bi bi-plus-circle"></i>
                Gerar novos
            </button>
        </div>
    </form>

    <form method="post" asp-page-handler="CopiarMesAnterior" class="fixed-copy-form" id="formCopiarMesAnterior">
        <input type="hidden" name="Pessoa" id="copyPessoa" value="@Model.Pessoa" />
        <input type="hidden" name="Periodo" id="copyPeriodo" value="@Model.Periodo" />
        <button type="submit" class="btn btn-outline-warning" title="Copia os fixos do mês anterior para o período informado">
            <i class="bi bi-arrow-down-circle"></i>
            Copiar mês anterior
        </button>
    </form>

    <ul class="nav nav-tabs fixed-tabs" id="fixosTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="fixos-mes-tab" data-bs-toggle="tab" data-bs-target="#fixos-mes" type="button" role="tab" aria-controls="fixos-mes" aria-selected="true">
                Fixos do mês
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="financiamentos-tab" data-bs-toggle="tab" data-bs-target="#financiamentos" type="button" role="tab" aria-controls="financiamentos" aria-selected="false">
                Financiamentos
            </button>
        </li>
    </ul>

    <div class="tab-content fixed-tab-content" id="fixosTabsContent">
        <div class="tab-pane fade show active" id="fixos-mes" role="tabpanel" aria-labelledby="fixos-mes-tab">
    @if (Model.FixosModel != null && Model.FixosModel.Any())
    {
        <section class="fixed-summary-grid" aria-label="Resumo dos gastos fixos">
            <div class="metric-card">
                <span>Total do mês</span>
                <strong>@totalFixos.ToString("C", cultura)</strong>
                <small>@quantidadeFixos gasto(s) fixo(s)</small>
            </div>
            <div class="metric-card metric-good">
                <span>Pago</span>
                <strong>@totalPago.ToString("C", cultura)</strong>
                <small>@quantidadePagos marcado(s)</small>
            </div>
            <div class="metric-card metric-warning">
                <span>Pendente</span>
                <strong>@totalPendente.ToString("C", cultura)</strong>
                <small>Somente para visualização</small>
            </div>
            <div class="metric-card">
                <span>Divididos</span>
                <strong>@quantidadeDivididos</strong>
                <small>Itens já rateados</small>
            </div>
        </section>

        <form id="formExcluir" method="post" asp-page-handler="Excluir">
            <input type="hidden" name="Id" id="formExcluir_Id" />
            <input type="hidden" name="MesAno" id="formExcluir_MesAno" />
            <input type="hidden" name="Pessoa" value="@Model.Pessoa" />
        </form>

        <div class="fixed-table-shell">
            <form method="post" asp-page-handler="Salvar">
                <div class="fixed-table-header">
                    <div>
                        <h4><i class="bi bi-table"></i> Conferência mensal</h4>
                        <p>Valores visíveis para facilitar a leitura do mês.</p>
                    </div>
                    <div class="fixed-save-actions"><span id="fixosDirtyStatus" class="form-text" aria-live="polite">Nenhuma alteração pendente</span><button type="submit" class="btn btn-success" id="btnSalvarFixos">
                        <i class="bi bi-save"></i>
                        Salvar todos
                    </button></div>
                </div>

                <div class="table-tools fixed-table-tools">
                    <div>
                        <label class="form-label" for="fixosBusca">Buscar</label>
                        <input id="fixosBusca" type="search" class="form-control" placeholder="Tipo, mês ou vencimento" />
                    </div>
                    <div>
                        <label class="form-label" for="fixosFiltroStatus">Status</label>
                        <select id="fixosFiltroStatus" class="form-select">
                            <option value="todos">Todos</option>
                            <option value="pago">Pagos</option>
                            <option value="pendente">Pendentes</option>
                            <option value="dividido">Divididos</option>
                        </select>
                    </div>
                    <div class="table-filter-status" id="fixosFiltroResultado"></div>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle fixed-table" id="gridFixos">
                        <thead>
                            <tr>
                                <th style="display:none">ID</th>
                                <th>Tipo</th>
                                <th>Mês/Ano</th>
                                <th>Vencimento</th>
                                <th>Valor</th>
                                <th>Status</th>
                                <th>Dividido</th>
                                <th>Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.FixosModel.Count; i++)
                            {
                                var fixo = Model.FixosModel[i];
                                var valor = ValorFixo(fixo.Valor);
                                var pago = FixoPago(fixo.Pago);
                                var dividido = FixoDividido(fixo.Dividido);
                                var status = pago ? "pago" : "pendente";
                                var valorInput = valor.ToString("0.##", CultureInfo.InvariantCulture);

                                <tr data-status="@status" data-dividido="@(dividido ? "sim" : "nao")">
                                    <td style="display:none">
                                        @fixo.Id
                                        <input type="hidden" name="FixosModel[@i].Id" value="@fixo.Id" />
                                    </td>
                                    <td>
                                        <strong>@fixo.Tipo</strong>
                                        <input type="hidden" name="FixosModel[@i].Tipo" value="@fixo.Tipo" />
                                    </td>
                                    <td>
                                        @fixo.MesAno
                                        <input type="hidden" name="FixosModel[@i].MesAno" value="@fixo.MesAno" />
                                    </td>
                                    <td>
                                        @fixo.Vencimento
                                        <input type="hidden" name="FixosModel[@i].Vencimento" value="@fixo.Vencimento" />
                                    </td>
                                    <td>
                                        <input type="number" step="0.01" class="form-control fixed-value-input"
                                               name="FixosModel[@i].Valor"
                                               value="@valorInput" />
                                    </td>
                                    <td>
                                        <label class="fixed-check">
                                            <input type="checkbox"
                                                   name="FixosModel[@i].Pago"
                                                   value="true"
                                                   @(pago ? "checked" : "") />
                                            <input type="hidden" name="FixosModel[@i].Pago" value="false" />
                                            <span class="status-badge @(pago ? "status-paid" : "status-open")">@(pago ? "Pago" : "Pendente")</span>
                                        </label>
                                    </td>
                                    <td>
                                        <label class="fixed-check">
                                            <input type="checkbox"
                                                   name="FixosModel[@i].Dividido"
                                                   value="true"
                                                   @(dividido ? "checked" : "") />
                                            <input type="hidden" name="FixosModel[@i].Dividido" value="false" />
                                            <span class="status-badge @(dividido ? "status-split" : "status-neutral")">@(dividido ? "Sim" : "Não")</span>
                                        </label>
                                    </td>
                                    <td>
                                        <div class="row-actions">
                                            <button type="button"
                                                    class="btn btn-warning btn-sm btnDividir"
                                                    aria-label="Dividir @fixo.Tipo"
                                                    title="Dividir gasto"
                                                    data-id="@fixo.Id"
                                                    data-tipo="@fixo.Tipo">
                                                <i class="bi bi-arrow-left-right"></i>
                                            </button>
                                            <button type="button"
                                                    form="formExcluir"
                                                    class="btn btn-secondary btn-sm"
                                                    aria-label="Excluir @fixo.Tipo"
                                                    title="Excluir gasto"
                                                    onclick="confirmarExcluir('@fixo.Id', '@fixo.MesAno', '@fixo.Tipo');">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </form>
        </div>
    }
            else
            {
                <div class="fixed-empty-state">
                    Liste ou gere os fixos do mês para visualizar os compromissos.
                </div>
            }
        </div>

        <div class="tab-pane fade" id="financiamentos" role="tabpanel" aria-labelledby="financiamentos-tab">
            <section class="finance-calculator-shell">
                <div class="fixed-table-header">
                    <div>
                        <h4><i class="bi bi-bank"></i> Calculadora de financiamentos</h4>
                        <p>Simule taxa, saldo devedor e amortização usando os financiamentos listados nos fixos.</p>
                    </div>
                    <div class="finance-leftover">
                        <label class="form-label" for="sobraMensal">Disponível pelo resumo</label>
                        <input id="sobraMensal"
                               type="number"
                               step="0.01"
                               min="0"
                               class="form-control"
                               value="@(Model.SaldoDisponivelResumo?.ToString("0.##", CultureInfo.InvariantCulture) ?? "")"
                               data-disponivel="@Model.SaldoDisponivelResumo.HasValue.ToString().ToLowerInvariant()"
                               placeholder="Liste os fixos para buscar o resumo"
                               readonly />
                        <small>@(Model.SaldoDisponivelResumo.HasValue ? "Saldo restante após contas" : "Saldo do resumo não encontrado para pessoa/período")</small>
                    </div>
                </div>

                @if (financiamentos.Any())
                {
                    <div class="table-responsive finance-table-wrap">
                        <table class="table table-bordered align-middle finance-table" id="gridFinanciamentos">
                            <thead>
                                <tr>
                                    <th>Financiamento</th>
                                    <th>Parcela atual</th>
                                    <th>Taxa de juros</th>
                                    <th>Valor que falta pagar</th>
                                    <th>Quitar em</th>
                                    <th>Resultado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var financiamento in financiamentos)
                                {
                                    var parcelaAtual = ValorFixo(financiamento.Valor);
                                    <tr class="finance-row" data-parcela-atual="@parcelaAtual.ToString("0.##", CultureInfo.InvariantCulture)">
                                        <td>
                                            <strong>@financiamento.Tipo</strong>
                                            <span>@financiamento.MesAno</span>
                                        </td>
                                        <td>
                                            <strong>@parcelaAtual.ToString("C", cultura)</strong>
                                        </td>
                                        <td>
                                            <div class="finance-rate-options" role="group" aria-label="Periodicidade da taxa de juros">
                                                <button type="button" class="btn btn-sm btn-outline-secondary active" data-rate-period="monthly">a.m.</button>
                                                <button type="button" class="btn btn-sm btn-outline-secondary" data-rate-period="annual">a.a.</button>
                                            </div>
                                            <div class="input-group">
                                                <input type="text" inputmode="decimal" class="form-control finance-rate" placeholder="1,90" />
                                                <span class="input-group-text finance-rate-suffix">% a.m.</span>
                                            </div>
                                            <small class="finance-rate-equivalent">Taxa usada: 0,0000% a.m.</small>
                                        </td>
                                        <td>
                                            <input type="number" step="0.01" min="0" class="form-control finance-balance" placeholder="Ex.: 30000" />
                                        </td>
                                        <td>
                                            <div class="finance-month-options" role="group" aria-label="Meses para quitação">
                                                <button type="button" class="btn btn-sm btn-outline-secondary active" data-months="12">12</button>
                                                <button type="button" class="btn btn-sm btn-outline-secondary" data-months="15">15</button>
                                                <button type="button" class="btn btn-sm btn-outline-secondary" data-months="18">18</button>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="finance-result">
                                                <span class="finance-installment">Informe os dados</span>
                                                <strong class="finance-extra">Amortização: R$ 0,00</strong>
                                                <small class="finance-interest">Juros estimados: R$ 0,00</small>
                                                <small class="finance-status">Sem simulação</small>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="fixed-empty-state">
                        Nenhum financiamento encontrado nos fixos carregados. A tela considera tipos contendo empréstimo, emprestimo, imóvel, imovel, financiamento, veículo ou veiculo.
                    </div>
                }
            </section>
        </div>
    </div>

    <div class="modal fade" id="dividirModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post" asp-page-handler="DividirGastoFixo">
                    <div class="modal-header">
                        <h5 class="modal-title">Dividir gasto fixo</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" name="IdGasto" id="modalIdGasto" />
                        <input type="hidden" name="ValorDivisao" id="modalValorDivisao" />
                        <div class="split-preview">
                            <span id="modalTipoGasto">Gasto fixo</span>
                            <strong id="modalValorMetade">R$ 0,00</strong>
                            <small>O valor será dividido por 2 automaticamente.</small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="modalDividirCom">Dividir com</label>
                            <input type="text" class="form-control" id="modalDividirCom" name="DividirCom" required />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check2-circle"></i>
                            Dividir
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="loading-overlay" id="loadingOverlay">
    <div>
        <div class="spinner-border text-primary" role="status"></div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/choices.js/public/assets/scripts/choices.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://unpkg.com/imask"></script>

    <script>
        let tiposFixosChoices = null;

        document.addEventListener("DOMContentLoaded", function () {
            const periodo = document.getElementById("Periodo");
            if (periodo && window.IMask) {
                IMask(periodo, {
                    mask: "00/0000",
                    placeholderChar: "_"
                });
            }

            carregarTiposFixos();
            configurarFiltrosFixos();
            configurarDivisaoPorDois();
            configurarBadges();
            configurarCopiaMesAnterior();
            configurarFinanciamentos();
            configurarAlteracoesFixos();
        });

        async function carregarTiposFixos() {
            const select = document.getElementById("TiposSelecionados");
            const status = document.getElementById("tiposFixosStatus");
            if (!select) return;

            const urlApi = "@(Model.UrlApi ?? "")";
            const endpoint = `${urlApi.replace(/\/?$/, "/")}Compra/GetTiposFixos`;
            const choices = window.Choices ? new Choices(select, {
                removeItemButton: true,
                shouldSort: false,
                placeholder: true,
                placeholderValue: "Selecione um ou mais tipos"
            }) : null;
            tiposFixosChoices = choices;

            document.getElementById("selecionarTodosTipos")?.addEventListener("click", () => {
                if (tiposFixosChoices) tiposFixosChoices.setChoiceByValue(Array.from(select.options).map(option => option.value));
                else Array.from(select.options).forEach(option => option.selected = true);
                atualizarQuantidadeTipos();
            });
            document.getElementById("limparTipos")?.addEventListener("click", () => {
                if (tiposFixosChoices) tiposFixosChoices.removeActiveItems();
                else Array.from(select.options).forEach(option => option.selected = false);
                atualizarQuantidadeTipos();
            });
            select.addEventListener("change", atualizarQuantidadeTipos);

            try {
                const response = await fetch(endpoint);
                if (response.status === 204) {
                    if (status) status.textContent = "Nenhum tipo fixo cadastrado.";
                    return;
                }

                if (!response.ok) {
                    throw new Error("Erro ao buscar tipos de fixos.");
                }

                const tipos = await response.json();
                const opcoes = tipos.map(tipo => ({
                    value: tipo,
                    label: tipo,
                    selected: false
                }));

                if (choices) {
                    choices.clearStore();
                    choices.setChoices(opcoes, "value", "label", true);
                } else {
                    select.innerHTML = "";
                    opcoes.forEach(opcao => {
                        const option = document.createElement("option");
                        option.value = opcao.value;
                        option.textContent = opcao.label;
                        select.appendChild(option);
                    });
                }

                if (status) status.textContent = `${opcoes.length} tipo(s) disponível(is) · nenhum selecionado`;
            } catch (error) {
                console.error("Erro ao carregar tipos de fixos:", error);
                if (status) status.textContent = "Não foi possível carregar os tipos. Confira se a API está ligada.";
            }

            function atualizarQuantidadeTipos() {
                const quantidade = Array.from(select.selectedOptions).length;
                const total = select.options.length;
                if (status) status.textContent = `${total} tipo(s) disponível(is) · ${quantidade} selecionado(s)`;
            }
        }

        function confirmarExcluir(id, mesAno, tipo) {
            Swal.fire({
                title: "Tem certeza?",
                text: `Deseja realmente excluir o fixo '${tipo}' do mês ${mesAno}?`,
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#d33",
                cancelButtonColor: "#3085d6",
                confirmButtonText: "Sim, excluir",
                cancelButtonText: "Cancelar"
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById("formExcluir_Id").value = id;
                    document.getElementById("formExcluir_MesAno").value = mesAno;
                    document.getElementById("formExcluir").submit();
                }
            });
        }

        function configurarFiltrosFixos() {
            const busca = document.getElementById("fixosBusca");
            const filtroStatus = document.getElementById("fixosFiltroStatus");
            const resultado = document.getElementById("fixosFiltroResultado");
            const linhas = Array.from(document.querySelectorAll("#gridFixos tbody tr"));
            if (!linhas.length) return;

            const aplicarFiltro = () => {
                const termo = (busca?.value || "").trim().toLowerCase();
                const status = filtroStatus?.value || "todos";
                let visiveis = 0;

                linhas.forEach(linha => {
                    const texto = linha.innerText.toLowerCase();
                    const statusLinha = linha.dataset.status;
                    const dividido = linha.dataset.dividido === "sim";
                    const bateTexto = !termo || texto.includes(termo);
                    const bateStatus = status === "todos"
                        || status === statusLinha
                        || (status === "dividido" && dividido);

                    const mostrar = bateTexto && bateStatus;
                    linha.style.display = mostrar ? "" : "none";
                    if (mostrar) visiveis++;
                });

                if (resultado) resultado.textContent = `${visiveis} de ${linhas.length} item(ns)`;
            };

            busca?.addEventListener("input", aplicarFiltro);
            filtroStatus?.addEventListener("change", aplicarFiltro);
            aplicarFiltro();
        }

        function configurarDivisaoPorDois() {
            const modalEl = document.getElementById("dividirModal");
            const grid = document.getElementById("gridFixos");
            if (!modalEl || !grid) return;

            const modal = new bootstrap.Modal(modalEl);
            const idInput = document.getElementById("modalIdGasto");
            const valorInput = document.getElementById("modalValorDivisao");
            const valorMetade = document.getElementById("modalValorMetade");
            const tipoGasto = document.getElementById("modalTipoGasto");

            grid.addEventListener("click", function (event) {
                const botao = event.target.closest(".btnDividir");
                if (!botao) return;

                const linha = botao.closest("tr");
                const valorCampo = linha?.querySelector(".fixed-value-input")?.value || "0";
                const valor = parseValor(valorCampo);
                const metade = valor / 2;

                idInput.value = botao.dataset.id || "";
                valorInput.value = metade.toFixed(2);
                valorMetade.textContent = metade.toLocaleString("pt-BR", { style: "currency", currency: "BRL" });
                tipoGasto.textContent = botao.dataset.tipo || "Gasto fixo";
                modal.show();
            });
        }

        function configurarBadges() {
            document.querySelectorAll(".fixed-check input[type='checkbox']").forEach(input => {
                input.addEventListener("change", () => {
                    const row = input.closest("tr");
                    const badge = input.parentElement.querySelector(".status-badge");
                    const isPago = input.name.includes(".Pago");
                    const checked = input.checked;

                    if (isPago) {
                        row.dataset.status = checked ? "pago" : "pendente";
                        badge.textContent = checked ? "Pago" : "Pendente";
                        badge.className = `status-badge ${checked ? "status-paid" : "status-open"}`;
                    } else {
                        row.dataset.dividido = checked ? "sim" : "nao";
                        badge.textContent = checked ? "Sim" : "Não";
                        badge.className = `status-badge ${checked ? "status-split" : "status-neutral"}`;
                    }
                });
            });
        }

        function configurarCopiaMesAnterior() {
            const form = document.getElementById("formCopiarMesAnterior");
            if (!form) return;

            form.addEventListener("submit", async event => {
                event.preventDefault();
                document.getElementById("copyPessoa").value = document.getElementById("Pessoa")?.value || "";
                document.getElementById("copyPeriodo").value = document.getElementById("Periodo")?.value || "";
                const resultado = await Swal.fire({ title: "Copiar mês anterior?", text: "Os fixos existentes não serão duplicados.", icon: "question", showCancelButton: true, confirmButtonText: "Sim, copiar", cancelButtonText: "Cancelar" });
                if (resultado.isConfirmed) form.submit();
            });
        }

        function configurarAlteracoesFixos() {
            const form = document.getElementById("btnSalvarFixos")?.closest("form");
            const status = document.getElementById("fixosDirtyStatus");
            if (!form || !status) return;
            let alterado = false;

            form.querySelectorAll(".fixed-value-input, .fixed-check input[type='checkbox']").forEach(campo => {
                campo.addEventListener("change", () => {
                    alterado = true;
                    status.textContent = "Alterações ainda não salvas";
                    status.classList.add("text-warning");
                });
                campo.addEventListener("input", () => {
                    alterado = true;
                    status.textContent = "Alterações ainda não salvas";
                    status.classList.add("text-warning");
                });
            });

            form.addEventListener("submit", () => { alterado = false; });
            window.addEventListener("beforeunload", event => {
                if (!alterado) return;
                event.preventDefault();
                event.returnValue = "";
            });
        }

        function configurarFinanciamentos() {
            const grid = document.getElementById("gridFinanciamentos");
            const sobraMensal = document.getElementById("sobraMensal");
            if (!grid) return;

            const linhas = Array.from(grid.querySelectorAll(".finance-row"));

            linhas.forEach(linha => {
                linha.querySelectorAll("input").forEach(input => {
                    input.addEventListener("input", () => calcularFinanciamento(linha));
                });

                linha.querySelectorAll("[data-months]").forEach(botao => {
                    botao.addEventListener("click", () => {
                        linha.querySelectorAll("[data-months]").forEach(item => item.classList.remove("active"));
                        botao.classList.add("active");
                        calcularFinanciamento(linha);
                    });
                });

                linha.querySelectorAll("[data-rate-period]").forEach(botao => {
                    botao.addEventListener("click", () => {
                        linha.querySelectorAll("[data-rate-period]").forEach(item => item.classList.remove("active"));
                        botao.classList.add("active");

                        const taxaAnual = botao.dataset.ratePeriod === "annual";
                        const sufixo = linha.querySelector(".finance-rate-suffix");
                        const taxa = linha.querySelector(".finance-rate");

                        if (sufixo) sufixo.textContent = taxaAnual ? "% a.a." : "% a.m.";
                        if (taxa) taxa.placeholder = taxaAnual ? "Ex.: 12,00" : "Ex.: 1,90";

                        calcularFinanciamento(linha);
                    });
                });

                calcularFinanciamento(linha);
            });

            sobraMensal?.addEventListener("input", () => {
                linhas.forEach(calcularFinanciamento);
            });
        }

        function calcularFinanciamento(linha) {
            const parcelaAtual = Number(linha.dataset.parcelaAtual || "0");
            const taxaInformada = parseValor(linha.querySelector(".finance-rate")?.value) / 100;
            const periodoTaxa = linha.querySelector("[data-rate-period].active")?.dataset.ratePeriod || "monthly";
            const taxaMensal = periodoTaxa === "annual"
                ? converterTaxaAnualParaMensal(taxaInformada)
                : taxaInformada;
            const saldoDevedor = parseValor(linha.querySelector(".finance-balance")?.value);
            const meses = Number(linha.querySelector("[data-months].active")?.dataset.months || "12");
            const sobraMensalEl = document.getElementById("sobraMensal");
            const sobraMensal = parseValor(sobraMensalEl?.value);
            const saldoDisponivel = sobraMensalEl?.dataset.disponivel === "true";

            const parcelaEl = linha.querySelector(".finance-installment");
            const extraEl = linha.querySelector(".finance-extra");
            const statusEl = linha.querySelector(".finance-status");
            const taxaEquivalenteEl = linha.querySelector(".finance-rate-equivalent");
            const jurosEl = linha.querySelector(".finance-interest");

            if (taxaEquivalenteEl) {
                taxaEquivalenteEl.textContent = `Taxa usada: ${formatarPercentual(taxaMensal * 100)}% a.m.`;
            }

            if (!saldoDevedor || saldoDevedor <= 0 || meses <= 0 || !Number.isFinite(taxaMensal) || taxaMensal < 0) {
                parcelaEl.textContent = "Informe os dados";
                extraEl.textContent = "Amortização: R$ 0,00";
                statusEl.textContent = "Sem simulação";
                statusEl.className = "finance-status";
                if (jurosEl) jurosEl.textContent = "Juros estimados: R$ 0,00";
                return;
            }

            const parcelaNecessaria = taxaMensal === 0
                ? saldoDevedor / meses
                : saldoDevedor * (taxaMensal / (1 - Math.pow(1 + taxaMensal, -meses)));

            const amortizacaoExtra = Math.max(parcelaNecessaria - parcelaAtual, 0);
            const totalComAmortizacao = parcelaAtual + amortizacaoExtra;

            parcelaEl.textContent = `Parcela para quitar: ${formatarMoeda(parcelaNecessaria)}`;
            extraEl.textContent = `Amortização: ${formatarMoeda(amortizacaoExtra)}`;
            if (jurosEl) jurosEl.textContent = `Juros estimados: ${formatarMoeda(Math.max(parcelaNecessaria * meses - saldoDevedor, 0))}`;

            if (saldoDisponivel) {
                const saldoLivre = sobraMensal - amortizacaoExtra;
                const cabeNoMes = saldoLivre >= 0;
                statusEl.textContent = cabeNoMes
                    ? `Cabe na sobra. Restaria ${formatarMoeda(saldoLivre)}`
                    : `Faltariam ${formatarMoeda(Math.abs(saldoLivre))} da sobra`;
                statusEl.className = `finance-status ${cabeNoMes ? "finance-ok" : "finance-alert"}`;
            } else {
                statusEl.textContent = `Total mensal estimado: ${formatarMoeda(totalComAmortizacao)}`;
                statusEl.className = "finance-status";
            }
        }

        function parseValor(valor) {
            let normalizado = String(valor || "0")
                .replace("R$", "")
                .trim();

            if (normalizado.includes(",")) {
                normalizado = normalizado.replace(/\./g, "").replace(",", ".");
            }

            const numero = Number(normalizado);
            return Number.isFinite(numero) ? numero : 0;
        }

        function converterTaxaAnualParaMensal(taxaAnual) {
            if (!Number.isFinite(taxaAnual) || taxaAnual < 0) return NaN;
            return Math.expm1(Math.log1p(taxaAnual) / 12);
        }

        function formatarPercentual(valor) {
            return valor.toLocaleString("pt-BR", {
                minimumFractionDigits: 4,
                maximumFractionDigits: 4
            });
        }

        function formatarMoeda(valor) {
            return valor.toLocaleString("pt-BR", { style: "currency", currency: "BRL" });
        }
    </script>
}

@functions {
    private static decimal ValorFixo(string? valor)
    {
        if (string.IsNullOrWhiteSpace(valor))
        {
            return 0;
        }

        var normalizado = valor
            .Replace("R$", "", StringComparison.OrdinalIgnoreCase)
            .Replace(" ", "")
            .Trim();

        var commaCount = normalizado.Count(c => c == ',');
        var dotCount = normalizado.Count(c => c == '.');

        if (commaCount > 0 && dotCount > 0)
        {
            normalizado = normalizado.LastIndexOf(",", StringComparison.Ordinal) > normalizado.LastIndexOf(".", StringComparison.Ordinal)
                ? normalizado.Replace(".", "").Replace(",", ".")
                : normalizado.Replace(",", "");
        }
        else if (commaCount > 0)
        {
            normalizado = normalizado.Replace(".", "").Replace(",", ".");
        }

        if (decimal.TryParse(normalizado, NumberStyles.Any, CultureInfo.InvariantCulture, out var valorInvariant))
        {
            return valorInvariant;
        }

        return 0;
    }

    private static bool FixoPago(string? pago)
    {
        return string.Equals(pago, "true", StringComparison.OrdinalIgnoreCase)
            || string.Equals(pago, "Sim", StringComparison.OrdinalIgnoreCase);
    }

    private static bool FixoDividido(string? dividido)
    {
        return string.Equals(dividido, "true", StringComparison.OrdinalIgnoreCase)
            || string.Equals(dividido, "Sim", StringComparison.OrdinalIgnoreCase);
    }

    private static bool EhFinanciamento(FixoModel? fixo)
    {
        var tipo = fixo?.Tipo ?? string.Empty;

        return tipo.Contains("imóvel", StringComparison.OrdinalIgnoreCase)
            || tipo.Contains("imovel", StringComparison.OrdinalIgnoreCase)
            || tipo.Contains("empréstimo", StringComparison.OrdinalIgnoreCase)
            || tipo.Contains("emprestimo", StringComparison.OrdinalIgnoreCase)
            || tipo.Contains("financiamento", StringComparison.OrdinalIgnoreCase)
            || tipo.Contains("veículo", StringComparison.OrdinalIgnoreCase)
            || tipo.Contains("veiculo", StringComparison.OrdinalIgnoreCase);
    }
}

