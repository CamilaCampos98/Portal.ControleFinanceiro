@page
@model IndexModel
@using System.Globalization
@{
    Layout = "_HomeLayout";
    ViewData["Title"] = "Visão geral";

    var cultura = new CultureInfo("pt-BR");
    var nomeUsuario = Model.ResumoAtual?.Pessoa ?? User.Identity?.Name ?? "Usuário";
    var primeiroNome = cultura.TextInfo.ToTitleCase(nomeUsuario.Trim().ToLower(cultura).Split(' ')[0]);
    var resumoAtualGeral = Model.ResumoGeral?
        .FirstOrDefault(item =>
            item.Pessoa.Equals(nomeUsuario, StringComparison.OrdinalIgnoreCase) &&
            item.MesAno == Model.PeriodoAtual);

    var receita = (Model.ResumoAtual?.Salario ?? 0) + (Model.ResumoAtual?.Extras ?? 0);
    var compras = Model.ResumoAtual?.TotalGasto ?? 0;
    var fixos = Model.ResumoAtual?.GastosFixos ?? 0;
    var guardado = Model.ResumoAtual?.ValorGuardado ?? resumoAtualGeral?.ValorGuardado ?? 0;
    var saldo = Model.ResumoAtual?.SaldoRestante ?? resumoAtualGeral?.SaldoRestante ?? 0;
    var comprometido = compras + fixos + guardado;
    var percentualComprometido = receita > 0 ? Math.Min(100, comprometido / receita * 100) : 0;
    var percentualDisponivel = receita > 0 ? Math.Max(0, saldo / receita * 100) : 0;

    var totalDistribuicao = comprometido + Math.Max(0, saldo);
    var percentualCompras = totalDistribuicao > 0 ? compras / totalDistribuicao * 100 : 0;
    var percentualFixos = totalDistribuicao > 0 ? fixos / totalDistribuicao * 100 : 0;
    var percentualGuardado = totalDistribuicao > 0 ? guardado / totalDistribuicao * 100 : 0;
    var fimCompras = percentualCompras;
    var fimFixos = fimCompras + percentualFixos;
    var fimGuardado = fimFixos + percentualGuardado;
    var graficoDistribuicao = FormattableString.Invariant(
        $"conic-gradient(var(--danger) 0 {fimCompras:0.##}%, var(--warning) {fimCompras:0.##}% {fimFixos:0.##}%, var(--home-saved) {fimFixos:0.##}% {fimGuardado:0.##}%, var(--accent) {fimGuardado:0.##}% 100%)");

    var cartoes = Model.ResumoAtual?.ResumoPorCartao?
        .Where(item => item.Value > 0)
        .OrderByDescending(item => item.Value)
        .ToList() ?? new List<KeyValuePair<string, decimal>>();
    var totalCartoes = cartoes.Sum(item => item.Value);

    var mesesProjetados = Model.ResumoGeral?
        .Where(item => item.Pessoa.Equals(nomeUsuario, StringComparison.OrdinalIgnoreCase))
        .Select(item => new
        {
            Resumo = item,
            Data = DateTime.TryParseExact(item.MesAno, "MM/yyyy", cultura, DateTimeStyles.None, out var data)
                ? data
                : DateTime.MinValue
        })
        .Where(item => item.Data != DateTime.MinValue)
        .OrderBy(item => item.Data)
        .Where(item => item.Data >= new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1))
        .Take(4)
        .ToList();
}

<main class="home-dashboard" aria-labelledby="homeTitle">
    @if (!string.IsNullOrEmpty(Model.Mensagem))
    {
        <section class="home-state home-state--error" role="alert">
            <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
            <div>
                <h1 id="homeTitle">Não foi possível carregar o resumo</h1>
                <p>Verifique a conexão com o serviço e tente novamente em alguns instantes.</p>
                <a class="btn btn-outline-danger" asp-page="/Index"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Tentar novamente</a>
            </div>
        </section>
    }
    else if (Model.ResumoGeral?.Any() == true)
    {
        <header class="home-heading">
            <div>
                <h1 id="homeTitle">Olá, @primeiroNome</h1>
                <p>Veja como está o seu orçamento neste mês.</p>
            </div>
            <div class="home-heading-actions">
                <span class="current-period"><i class="bi bi-calendar3" aria-hidden="true"></i> @(Model.PeriodoAtual ?? "Período atual")</span>
                <a class="home-primary-action" asp-page="/Controle/RegistrarCompra"><i class="bi bi-plus-lg" aria-hidden="true"></i><span>Nova compra</span></a>
            </div>
        </header>

        <section class="home-metric-grid" aria-label="Resumo financeiro do período">
            <article class="home-metric home-metric--balance @(saldo < 0 ? "home-metric--negative" : "")">
                <span>Saldo disponível</span>
                <strong>@saldo.ToString("C", cultura)</strong>
                <small>@percentualDisponivel.ToString("0", cultura)% da renda ainda disponível</small>
                <div class="home-progress" role="progressbar" aria-label="Percentual da renda comprometida" aria-valuenow="@percentualComprometido.ToString("0", CultureInfo.InvariantCulture)" aria-valuemin="0" aria-valuemax="100"><span style="width: @percentualComprometido.ToString("0.##", CultureInfo.InvariantCulture)%"></span></div>
            </article>
            <article class="home-metric"><span>Entradas</span><strong>@receita.ToString("C", cultura)</strong><small>Salário e extras</small></article>
            <article class="home-metric"><span>Total gasto</span><strong>@compras.ToString("C", cultura)</strong><small>Compras do período</small></article>
            <article class="home-metric"><span>Guardado</span><strong>@guardado.ToString("C", cultura)</strong><small>Reserva deste mês</small></article>
        </section>

        <div class="home-content-grid">
            <div class="home-content-main">
                <section class="home-panel" aria-labelledby="distribuicaoTitulo">
                    <div class="home-panel-heading">
                        <h2 id="distribuicaoTitulo">Distribuição do mês</h2>
                        <a asp-page="/Controle/Resumo" asp-route-pessoa="@nomeUsuario" asp-route-periodo="@Model.PeriodoAtual">Ver detalhes</a>
                    </div>
                    <div class="home-distribution">
                        <div class="home-donut" style="background: @graficoDistribuicao" role="img" aria-label="Distribuição entre compras, gastos fixos, valor guardado e saldo disponível"><span></span></div>
                        <div class="home-legend">
                            <div><i class="home-legend-dot home-legend-dot--purchases"></i><span>Compras</span><strong>@compras.ToString("C", cultura)</strong></div>
                            <div><i class="home-legend-dot home-legend-dot--fixed"></i><span>Gastos fixos</span><strong>@fixos.ToString("C", cultura)</strong></div>
                            <div><i class="home-legend-dot home-legend-dot--saved"></i><span>Guardado</span><strong>@guardado.ToString("C", cultura)</strong></div>
                            <div><i class="home-legend-dot home-legend-dot--available"></i><span>Disponível</span><strong>@saldo.ToString("C", cultura)</strong></div>
                        </div>
                    </div>
                </section>

                <section class="home-panel" aria-labelledby="comprasRecentesTitulo">
                    <div class="home-panel-heading">
                        <h2 id="comprasRecentesTitulo">Compras recentes</h2>
                        <a asp-page="/Controle/Resumo" asp-route-pessoa="@nomeUsuario" asp-route-periodo="@Model.PeriodoAtual">Ver todas</a>
                    </div>
                    @if (Model.ComprasRecentes.Any())
                    {
                        @foreach (var grupo in Model.ComprasRecentes.GroupBy(item => item.Data.Date).OrderByDescending(grupo => grupo.Key))
                        {
                            var rotuloData = grupo.Key == DateTime.Today
                                ? $"Hoje, {grupo.Key:dd 'de' MMMM}"
                                : grupo.Key == DateTime.Today.AddDays(-1)
                                    ? $"Ontem, {grupo.Key:dd 'de' MMMM}"
                                    : grupo.Key.ToString("dd 'de' MMMM", cultura);
                            <h3 class="home-purchase-day">@rotuloData</h3>
                            <div class="home-purchase-list">
                                @foreach (var compraRecente in grupo)
                                {
                                    <article class="home-purchase-item">
                                        <span class="home-purchase-icon"><i class="bi bi-bag" aria-hidden="true"></i></span>
                                        <div>
                                            <strong>@compraRecente.Descricao</strong>
                                            <small>@compraRecente.Cartao · @compraRecente.FormaPagamento @(!string.IsNullOrWhiteSpace(compraRecente.Parcela) ? $"· {compraRecente.Parcela}" : "")</small>
                                        </div>
                                        <div class="home-purchase-value"><strong>@compraRecente.Valor.ToString("C", cultura)</strong><small>Período @Model.PeriodoAtual</small></div>
                                    </article>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="home-inline-empty"><i class="bi bi-cart-x" aria-hidden="true"></i><span>Nenhuma compra encontrada neste período.</span></div>
                    }
                </section>
            </div>

            <aside class="home-content-aside">
                <section class="home-panel" aria-labelledby="cartoesTitulo">
                    <div class="home-panel-heading"><h2 id="cartoesTitulo">Cartões</h2><a asp-page="/Controle/Resumo" asp-route-pessoa="@nomeUsuario" asp-route-periodo="@Model.PeriodoAtual">Detalhes</a></div>
                    @if (cartoes.Any())
                    {
                        <div class="home-card-list">
                            @foreach (var cartao in cartoes.Take(5))
                            {
                                var participacao = totalCartoes > 0 ? cartao.Value / totalCartoes * 100 : 0;
                                <article class="home-card-item">
                                    <div><span>@cartao.Key</span><strong>@cartao.Value.ToString("C", cultura)</strong></div>
                                    <div class="home-card-bar"><span style="width: @participacao.ToString("0.##", CultureInfo.InvariantCulture)%"></span></div>
                                    <small>@participacao.ToString("0", cultura)% das compras em cartão</small>
                                </article>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="home-inline-empty"><span>Nenhum gasto em cartão neste período.</span></div>
                    }
                </section>

                <section class="home-panel" aria-labelledby="projecaoTitulo">
                    <div class="home-panel-heading"><h2 id="projecaoTitulo">Próximos meses</h2></div>
                    @if (mesesProjetados?.Any() == true)
                    {
                        <div class="home-forecast-list">
                            @foreach (var item in mesesProjetados)
                            {
                                <a asp-page="/Controle/Resumo" asp-route-pessoa="@nomeUsuario" asp-route-periodo="@item.Resumo.MesAno">
                                    <span>@item.Data.ToString("MMMM", cultura)</span>
                                    <strong class="@(item.Resumo.SaldoRestante < 0 ? "is-negative" : "")">@item.Resumo.SaldoRestante.ToString("C", cultura)</strong>
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="home-inline-empty"><span>Nenhuma projeção encontrada.</span></div>
                    }
                </section>
            </aside>
        </div>
    }
    else
    {
        <section class="home-state" aria-labelledby="homeTitle">
            <i class="bi bi-bar-chart" aria-hidden="true"></i>
            <div>
                <h1 id="homeTitle">Seu resumo financeiro aparecerá aqui</h1>
                <p>Ainda não encontramos dados para apresentar. Registre uma entrada ou uma compra para começar.</p>
                <div class="d-flex flex-wrap gap-2"><a class="btn btn-success" asp-page="/Controle/RegistrarEntrada">Registrar entrada</a><a class="btn btn-outline-success" asp-page="/Controle/RegistrarCompra">Registrar compra</a></div>
            </div>
        </section>
    }
</main>
