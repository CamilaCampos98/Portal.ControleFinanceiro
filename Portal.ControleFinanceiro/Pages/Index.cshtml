@page
@model IndexModel
@using System.Globalization
@{
    ViewData["Title"] = "Resumo financeiro";
    var cultura = new CultureInfo("pt-BR");
    var inicioProjecao = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    var meses = Enumerable.Range(0, 7)
        .Select(deslocamento => inicioProjecao.AddMonths(deslocamento).ToString("MM/yyyy", cultura))
        .ToList();
    var pessoas = Model.ResumoGeral?.Where(x => !string.IsNullOrWhiteSpace(x.Pessoa)).GroupBy(x => x.Pessoa).OrderBy(g => g.Key).ToList();
}

<main class="home-dashboard" aria-labelledby="homeTitle">
    @if (!string.IsNullOrEmpty(Model.Mensagem))
    {
        <section class="home-state home-state--error" role="alert">
            <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
            <div>
                <h1 id="homeTitle">Não foi possível carregar o resumo</h1>
                <p>Verifique a conexão com o serviço e tente novamente em alguns instantes.</p>
                <a class="btn btn-outline-danger" asp-page="/Index"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Tentar novamente</a>
            </div>
        </section>
    }
    else if (pessoas != null && pessoas.Any())
    {
        <header class="home-heading">
            <div>
                <span class="eyebrow">Visão geral</span>
                <h1 id="homeTitle">Resumo financeiro</h1>
                <p>Acompanhe o saldo disponível e as movimentações mais recentes.</p>
            </div>
            <div class="current-period" aria-label="Período atual da fatura do cartão principal Itaú">
                <i class="bi bi-calendar3" aria-hidden="true"></i>
                <span>Fatura Itaú atual</span>
                <strong>@(Model.PeriodoAtual ?? "Não identificada")</strong>
            </div>
        </header>

        <nav class="home-shortcuts" aria-label="Atalhos financeiros">
            <a class="home-shortcut home-shortcut--primary" asp-page="/Controle/RegistrarCompra"><i class="bi bi-cart-plus" aria-hidden="true"></i><span><strong>Nova compra</strong><small>Registrar uma movimentação</small></span></a>
            <a class="home-shortcut" asp-page="/Controle/Resumo"><i class="bi bi-bar-chart-line" aria-hidden="true"></i><span><strong>Resumo detalhado</strong><small>Consultar pessoa e período</small></span></a>
            <a class="home-shortcut" asp-page="/Controle/Fixos"><i class="bi bi-calendar-check" aria-hidden="true"></i><span><strong>Fixos</strong><small>Contas e financiamentos</small></span></a>
            <a class="home-shortcut" asp-page="/Controle/RegistrarEntrada"><i class="bi bi-wallet2" aria-hidden="true"></i><span><strong>Nova entrada</strong><small>Registrar receita</small></span></a>
        </nav>

        <section class="home-section" aria-labelledby="saldoAtualTitulo">
            <div class="home-section-heading">
                <div><span class="eyebrow">Disponibilidade</span><h2 id="saldoAtualTitulo">Saldo atual por pessoa</h2></div>
                <span class="home-section-caption">Referência: @(Model.PeriodoAtual ?? "período não identificado")</span>
            </div>
            <div class="current-balance-grid">
                @foreach (var grupo in pessoas)
                {
                    var resumoAtual = string.IsNullOrWhiteSpace(Model.PeriodoAtual) ? null : grupo.FirstOrDefault(x => x.MesAno == Model.PeriodoAtual);
                    var periodoConsulta = Model.PeriodoAtual ?? grupo
                        .Select(x => x.MesAno)
                        .OrderByDescending(m => DateTime.TryParseExact(m, "MM/yyyy", cultura, DateTimeStyles.None, out var data) ? data : DateTime.MinValue)
                        .FirstOrDefault();
                    var saldoClass = resumoAtual == null ? "balance-card--empty" : resumoAtual.SaldoRestante < 0 ? "balance-card--negative" : "balance-card--positive";
                    <article class="balance-card @saldoClass">
                        <div class="balance-card__header">
                            <span class="balance-person"><i class="bi bi-person-circle" aria-hidden="true"></i> @grupo.Key</span>
                            @if (resumoAtual == null) { <span class="balance-status">Sem dados</span> }
                            else if (resumoAtual.SaldoRestante < 0) { <span class="balance-status"><i class="bi bi-exclamation-circle" aria-hidden="true"></i> Negativo</span> }
                            else { <span class="balance-status"><i class="bi bi-check-circle" aria-hidden="true"></i> Disponível</span> }
                        </div>
                        <span class="balance-label">Saldo</span>
                        <strong class="balance-value">@(resumoAtual == null ? "—" : resumoAtual.SaldoRestante.ToString("C", cultura))</strong>
                        <div class="balance-saved"><span>Valor guardado</span><strong>@(resumoAtual == null ? "—" : resumoAtual.ValorGuardado.ToString("C", cultura))</strong></div>
                        <a asp-page="/Controle/Resumo"
                           asp-route-pessoa="@grupo.Key"
                           asp-route-periodo="@periodoConsulta"
                           aria-label="Ver resumo detalhado de @grupo.Key no período @periodoConsulta">Ver resumo <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                    </article>
                }
            </div>
        </section>

        <section class="home-section" aria-labelledby="ultimasComprasTitulo">
            <div class="home-section-heading">
                <div><span class="eyebrow">Movimentações</span><h2 id="ultimasComprasTitulo">Sua última compra</h2></div>
                <span class="home-section-caption">Compras registradas até hoje</span>
            </div>
            @if (Model.UltimasComprasPorPessoa.Any())
            {
                <div class="latest-purchase-grid">
                    @foreach (var compra in Model.UltimasComprasPorPessoa)
                    {
                        <article class="latest-purchase-card">
                            <div class="latest-purchase-card__top"><span class="purchase-person"><i class="bi bi-person" aria-hidden="true"></i> @compra.Pessoa</span><strong>@compra.Valor.ToString("C", cultura)</strong></div>
                            <h3>@compra.Descricao</h3>
                            <div class="purchase-meta">
                                <time datetime="@compra.Data.ToString("yyyy-MM-dd")"><i class="bi bi-calendar-event" aria-hidden="true"></i> @compra.Data.ToString("dd/MM/yyyy")</time>
                                <span><i class="bi bi-credit-card" aria-hidden="true"></i> @compra.Cartao</span>
                                @if (!string.IsNullOrWhiteSpace(compra.Parcela)) { <span class="purchase-installment">Parcela @compra.Parcela</span> }
                            </div>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="home-inline-empty"><i class="bi bi-cart-x" aria-hidden="true"></i><span>Nenhuma compra encontrada no período atual até hoje.</span></div>
            }
        </section>

        <section class="home-section" aria-labelledby="historicoTitulo">
            <div class="home-section-heading">
                <div><span class="eyebrow">Próximos meses</span><h2 id="historicoTitulo">Projeção de saldos</h2></div>
                <span class="home-section-caption">Mês atual e os próximos seis meses</span>
            </div>
            <div class="table-responsive history-table-shell" tabindex="0" aria-label="Projeção de saldos dos próximos meses por pessoa">
                <table class="table history-table mb-0">
                    <thead><tr><th scope="col">Pessoa</th>@foreach (var mes in meses) { <th scope="col">@mes</th> }</tr></thead>
                    <tbody>
                        @foreach (var grupo in pessoas)
                        {
                            <tr>
                                <th scope="row">@grupo.Key</th>
                                @foreach (var mes in meses)
                                {
                                    var resumoMes = grupo.FirstOrDefault(x => x.MesAno == mes);
                                    <td class="@(resumoMes != null && resumoMes.SaldoRestante < 0 ? "history-value--negative" : "")">
                                        @if (resumoMes == null) { <span class="history-empty" aria-label="Sem dados">—</span> }
                                        else { <strong>@resumoMes.SaldoRestante.ToString("C", cultura)</strong><small>Guardado: @resumoMes.ValorGuardado.ToString("C", cultura)</small> }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
    else
    {
        <section class="home-state" aria-labelledby="homeTitle">
            <i class="bi bi-bar-chart" aria-hidden="true"></i>
            <div><h1 id="homeTitle">Seu resumo financeiro aparecerá aqui</h1><p>Ainda não encontramos dados para apresentar. Registre uma entrada ou uma compra para começar.</p><div class="d-flex flex-wrap gap-2"><a class="btn btn-success" asp-page="/Controle/RegistrarEntrada">Registrar entrada</a><a class="btn btn-outline-success" asp-page="/Controle/RegistrarCompra">Registrar compra</a></div></div>
        </section>
    }
</main>
